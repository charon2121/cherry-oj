#!/bin/sh
#
# pre-push：跑测试（实测 ~6s）。
#
# 为什么不放 pre-commit：6 秒 × 一天十几次提交，人会开始用 --no-verify 绕过，
# 那 hook 就形同虚设。放在 push 前跑一次，频率低得多，又能赶在 CI 之前发现问题。
#
# -race 是硬要求：pool 的并发用例在普通模式下可能几百次都不复现竞态。
# -count=1 关掉结果缓存，别让「上次绿过」冒充这次的结论。
#
# 绕过：git push --no-verify

set -eu

ENGINE=apps/judge-engine
WEB=apps/web
go_changed=1
web_changed=1

# 只在对应工程真有改动要推的时候跑，Go 和 Web 独立判断，不能互相提前退出。
# 全局文档与开发文档不触发语言工程测试；其结构校验由 pre-commit 和 CI 负责。
range=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [ -n "$range" ]; then
    [ -n "$(git diff --name-only "$range"...HEAD -- "$ENGINE" || true)" ] || go_changed=0
    [ -n "$(git diff --name-only "$range"...HEAD -- "$WEB" || true)" ] || web_changed=0
fi

if [ "$go_changed" -eq 1 ]; then
    echo "→ go test -race ./...（约 6s，跳过用 git push --no-verify）"
    if ! (cd "$ENGINE" && go test -race -count=1 ./...); then
        echo
        echo "✗ Go 测试未通过，已阻止推送。"
        echo "（确实要跳过：git push --no-verify）"
        exit 1
    fi
else
    echo "→ 本次推送没有 $ENGINE 的改动，跳过 Go 测试"
fi

if [ "$web_changed" -eq 1 ]; then
    echo "→ npm run check && npm run build（跳过用 git push --no-verify）"
    if ! (cd "$WEB" && npm run check && npm run build); then
        echo
        echo "✗ Web 检查未通过，已阻止推送。"
        echo "（确实要跳过：git push --no-verify）"
        exit 1
    fi
else
    echo "→ 本次推送没有 $WEB 的改动，跳过 Web 检查"
fi
exit 0
