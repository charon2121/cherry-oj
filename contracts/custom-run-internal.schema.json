{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/custom-run-internal.schema.json",
  "title": "Custom run internal",
  "description": "submission-service→judging-service POST /internal/submission/trials，服务凭据认证。正文禁止日志，无重试。deadlineEpochMs为传输期限，非程序资源度量。CORE 时 source 为驱动文件，另带用户文件 solutionSource 与前缀行数，judging-service 据此换算报错行号。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problemId",
    "languageId",
    "source",
    "inputText",
    "deadlineEpochMs"
  ],
  "properties": {
    "problemId": {
      "type": "string",
      "format": "uuid"
    },
    "languageId": {
      "type": "string",
      "const": "cpp"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "description": "ACM 为用户程序（UTF-8 最多 256 KiB，由 submission-service 在入口检查）；CORE 为驱动文件"
    },
    "solutionSource": {
      "type": "string",
      "minLength": 1,
      "description": "仅 CORE：用户文件 = 该语言前缀 + 用户源码"
    },
    "solutionPrefixLineCount": {
      "type": "integer",
      "minimum": 0,
      "description": "仅 CORE：前缀中换行符的个数"
    },
    "inputText": {
      "type": "string",
      "maxLength": 65536,
      "description": "UTF-8最多64KiB，空串合法，不trim"
    },
    "deadlineEpochMs": {
      "type": "integer",
      "minimum": 1
    }
  },
  "dependencies": {
    "solutionSource": [
      "solutionPrefixLineCount"
    ],
    "solutionPrefixLineCount": [
      "solutionSource"
    ]
  },
  "definitions": {
    "Response": {
      "type": "object",
      "required": [
        "status",
        "effectiveLimits"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "COMPILE_ERROR",
            "RUNTIME_ERROR",
            "TIME_LIMIT_EXCEEDED",
            "MEMORY_LIMIT_EXCEEDED",
            "OUTPUT_LIMIT_EXCEEDED"
          ]
        },
        "cpuNs": {
          "type": "integer",
          "minimum": 0
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "$ref": "web-api.openapi.json#/components/schemas/CustomRunOutput"
        },
        "stderr": {
          "$ref": "web-api.openapi.json#/components/schemas/CustomRunOutput"
        },
        "compileDiagnostic": {
          "type": "string",
          "maxLength": 8192
        },
        "effectiveLimits": {
          "$ref": "web-api.openapi.json#/components/schemas/CustomRunLimits"
        }
      }
    }
  }
}
