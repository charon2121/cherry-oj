{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/execution-profile.schema.json",
  "title": "ExecutionProfile v1",
  "description": "judging-service 为 submission-service 解析的不可变执行配置。只有目标语言有在线节点、该节点已按 hash 安装测试数据、题目版本×语言的标定 VALID 时返回；失败时禁止生成默认限制。",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problemVersionId",
    "testDataVersionId",
    "languageId",
    "languageCalibrationId",
    "effectiveLimits"
  ],
  "properties": {
    "problemVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "testDataVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "languageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "languageCalibrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effectiveLimits": {
      "$ref": "judge.schema.json#/definitions/JudgeLimits"
    },
    "executionBudgetNs": {
      "type": "integer",
      "minimum": 1,
      "description": "完整调用的传输预算 ns；由配置与测例数计算，不能改变判题限制。"
    }
  },
  "definitions": {
    "ResolveExecutionProfileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemVersionId",
        "testDataVersionId",
        "testDataContentSha256",
        "languageId"
      ],
      "properties": {
        "problemVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "testDataVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "testDataContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "totalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "purpose": {
          "type": "string",
          "enum": [
            "formal",
            "trial"
          ],
          "default": "formal",
          "description": "trial 使用单 case 预算，不改变有效运行限制。"
        }
      },
      "examples": [
        {
          "problemVersionId": "0198cafe-0000-7000-8000-000000000003",
          "testDataVersionId": "0198cafe-0000-7000-8000-000000000004",
          "testDataContentSha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
          "languageId": "cpp"
        }
      ]
    }
  },
  "examples": [
    {
      "problemVersionId": "0198cafe-0000-7000-8000-000000000003",
      "testDataVersionId": "0198cafe-0000-7000-8000-000000000004",
      "languageId": "cpp",
      "languageCalibrationId": "0198cafe-0000-7000-8000-000000000006",
      "effectiveLimits": {
        "cpuNs": 1000000000,
        "memoryBytes": 268435456
      }
    }
  ]
}
