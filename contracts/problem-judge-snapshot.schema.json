{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/problem-judge-snapshot.schema.json",
  "title": "ProblemJudgeSnapshot v1",
  "description": "problem-service → submission-service 的内部判题快照。只在题目 ACTIVE/PUBLIC、语言已允许且已有测试数据时返回；不含测试数据地址，地址由 judging-service 在判题时向 problem-service 取。judgeTemplate 是内部敏感字段，不得透传浏览器、日志或 Kafka。",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problemId",
    "problemTitle",
    "languageId",
    "codeMode"
  ],
  "properties": {
    "problemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "problemTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "languageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "codeMode": {
      "type": "string",
      "enum": [
        "ACM",
        "CORE"
      ]
    },
    "judgeTemplate": {
      "type": "string",
      "maxLength": 1048576,
      "description": "仅 CORE 返回；公开检查保证包含且只包含一个字面量 {{USER_CODE}}"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "codeMode": {
            "const": "CORE"
          }
        },
        "required": [
          "codeMode"
        ]
      },
      "then": {
        "required": [
          "judgeTemplate"
        ]
      },
      "else": {
        "not": {
          "required": [
            "judgeTemplate"
          ]
        }
      }
    }
  ],
  "examples": [
    {
      "problemId": "0198cafe-0000-7000-8000-000000000002",
      "problemTitle": "A + B",
      "languageId": "cpp",
      "codeMode": "CORE",
      "judgeTemplate": "#include <iostream>\n{{USER_CODE}}\nint main() { return 0; }"
    }
  ]
}
