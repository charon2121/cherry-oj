{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/judge.schema.json",
  "title": "Judge v2",
  "description": "judging-service ↔ Go judge 跨语言契约（唯一真源）。时间单位 ns，内存单位 bytes。正式判题按不可变 testDataVersionId 定位测试数据；problemId/problemVersionId 只用于日志与对账。source 对 ACM/CORE 都是 submission-service 已准备好的完整源码。Go judge 不知道用户、代码模式、模板、标定、Kafka 或 Submission 生命周期。",
  "x-contract-version": 2,
  "definitions": {
    "JudgeMode": {
      "type": "string",
      "description": "submit=按 testDataVersionId 从磁盘加载正式测例；trial=使用请求内 cases。它只决定测例来源，不决定结果是否入库。",
      "enum": ["submit", "trial"]
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excerpt", "bytes"],
      "description": "用户程序的受控输出摘要。不得包含隐藏输入或标准答案。",
      "properties": {
        "excerpt": {
          "type": "string",
          "maxLength": 65536,
          "description": "前若干字节；实际限制由判题机配置决定"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "judge 实际收到的 stdout 字节数"
        },
        "truncated": {
          "type": "boolean",
          "description": "excerpt 短于 judge 收到的内容"
        },
        "ref": {
          "type": "string",
          "maxLength": 512,
          "description": "可选的完整内容短期引用；MVP 不填"
        }
      }
    },
    "Diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "description": "WA 时第一处差异。want 是否返回由 judge.revealExpected 决定。",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "got": {
          "type": "string",
          "maxLength": 65536
        },
        "want": {
          "type": "string",
          "maxLength": 65536,
          "description": "可能包含标准答案片段；正式部署默认省略"
        }
      }
    },
    "CaseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "description": "trial 的一个文本测试点。expected 缺省表示只运行、不比对。",
      "properties": {
        "input": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "JudgeLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuNs", "memoryBytes"],
      "description": "本次判题已解析并冻结的环境相关绝对限制。judge 不计算语言倍率。",
      "properties": {
        "cpuNs": {
          "type": "integer",
          "minimum": 1,
          "description": "每个测试点的 CPU 时间上限"
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "每个测试点的内存上限"
        },
        "clockNs": {
          "type": "integer",
          "minimum": 1,
          "description": "可选墙钟上限；缺省由 judge 的运行策略从 cpuNs 推算"
        }
      }
    },
    "JudgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submissionId",
        "problemId",
        "problemVersionId",
        "testDataVersionId",
        "languageId",
        "source",
        "limits"
      ],
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "提交 id；只用于日志与对账"
        },
        "problemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "稳定题目 id；只用于日志与对账"
        },
        "problemVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "不可变题目版本 id；只用于日志与对账"
        },
        "testDataVersionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "正式判题的测试数据目录键：<testdata-root>/<testDataVersionId>/"
        },
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Go judge language registry token，例如 cpp"
        },
        "source": {
          "type": "string",
          "description": "完整源码；CORE 模板已由 submission-service 合并"
        },
        "limits": {
          "$ref": "#/definitions/JudgeLimits"
        },
        "mode": {
          "$ref": "#/definitions/JudgeMode",
          "description": "缺省 submit"
        },
        "cases": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/CaseSpec" },
          "description": "mode=trial 时使用；mode=submit 时忽略"
        }
      },
      "examples": [
        {
          "submissionId": "0198cafe-0000-7000-8000-000000000001",
          "problemId": "0198cafe-0000-7000-8000-000000000002",
          "problemVersionId": "0198cafe-0000-7000-8000-000000000003",
          "testDataVersionId": "0198cafe-0000-7000-8000-000000000004",
          "languageId": "cpp",
          "source": "int main() { return 0; }",
          "limits": {
            "cpuNs": 1000000000,
            "memoryBytes": 268435456
          }
        }
      ]
    },
    "CaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idx", "verdict"],
      "properties": {
        "idx": {
          "type": "integer",
          "minimum": 1
        },
        "verdict": {
          "$ref": "verdict.json"
        },
        "cpuNs": {
          "type": "integer",
          "minimum": 0
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "maxLength": 8192
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "output": {
          "$ref": "#/definitions/Output"
        },
        "diff": {
          "$ref": "#/definitions/Diff"
        }
      }
    },
    "JudgeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "environmentFingerprint"],
      "description": "Go judge 的结果。environmentFingerprint 来自 judge 部署配置，不从请求回显。",
      "properties": {
        "verdict": {
          "$ref": "verdict.json"
        },
        "environmentFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "实际执行环境指纹；judging-service 必须与冻结的 JudgeInput 对比"
        },
        "cpuNs": {
          "type": "integer",
          "minimum": 0,
          "description": "各测试点 CPU 时间最大值"
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "各测试点内存峰值最大值"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "maxLength": 8192
        },
        "caseResults": {
          "type": "array",
          "maxItems": 1000,
          "description": "严格按实际执行顺序排列，idx 从 1 递增",
          "items": {
            "$ref": "#/definitions/CaseResult"
          }
        }
      },
      "examples": [
        {
          "verdict": "AC",
          "environmentFingerprint": "sha256:judge-env-amd64-v1",
          "cpuNs": 1200000,
          "memoryBytes": 1048576,
          "score": 100,
          "caseResults": [
            {
              "idx": 1,
              "name": "1",
              "verdict": "AC",
              "cpuNs": 1200000,
              "memoryBytes": 1048576
            }
          ]
        }
      ]
    }
  }
}
