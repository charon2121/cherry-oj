{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherry-oj/contracts/judge-node.schema.json",
  "title": "Judge Node control protocol v1",
  "description": "Private shared Bearer control token. POST /internal/judge-nodes/v1/register and /heartbeat accept Registration/Heartbeat and return Lease. POST /internal/judge-node/v1/install accepts multipart/form-data: metadata (Install JSON, first, <= 1 MiB), archive (ZIP, second); returns Receipt. No redirects. Session UUID changes on process start; registration invalidates availability of historical receipts on session change, requiring actual reinstallation before routing. Errors contain only fixed code/detail. Node identity is nodeId plus the per-process sessionId; there is no environment identity; endpoints are absolute HTTP(S) origins without credentials, query, fragment or path.",
  "oneOf": [
    {
      "$ref": "#/$defs/Registration"
    },
    {
      "$ref": "#/$defs/Heartbeat"
    },
    {
      "$ref": "#/$defs/Lease"
    },
    {
      "$ref": "#/$defs/Install"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseCount",
        "totalBytes",
        "files"
      ],
      "properties": {
        "caseCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sizeBytes",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.(in|out)$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "Registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "sessionId",
        "endpoint",
        "languages"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "description": "节点能判的语言；控制面只把该语言的判题路由给声明了它的节点。",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        }
      },
      "examples": [
        {
          "nodeId": "judge-local-1",
          "sessionId": "019c8e42-7f70-7000-8000-000000000001",
          "endpoint": "http://127.0.0.1:5051",
          "languages": [
            "cpp"
          ]
        }
      ]
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "sessionId"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "examples": [
        {
          "nodeId": "judge-local-1",
          "sessionId": "019c8e42-7f70-7000-8000-000000000001"
        }
      ]
    },
    "Lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "leaseDurationNs"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "leaseDurationNs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "examples": [
        {
          "nodeId": "judge-local-1",
          "leaseDurationNs": 35000000000
        }
      ]
    },
    "Install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "sessionId",
        "testDataVersionId",
        "expectedSha256",
        "manifest"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "testDataVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        }
      },
      "examples": [
        {
          "nodeId": "judge-local-1",
          "sessionId": "019c8e42-7f70-7000-8000-000000000001",
          "testDataVersionId": "019c8e42-7f70-7000-8000-000000000002",
          "expectedSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "manifest": {
            "caseCount": 1,
            "totalBytes": 2,
            "files": [
              {
                "name": "1.in",
                "sizeBytes": 1,
                "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
              },
              {
                "name": "1.out",
                "sizeBytes": 1,
                "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
              }
            ]
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "sessionId",
        "testDataVersionId",
        "sha256",
        "fileCount"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "testDataVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000
        }
      },
      "examples": [
        {
          "nodeId": "judge-local-1",
          "sessionId": "019c8e42-7f70-7000-8000-000000000001",
          "testDataVersionId": "019c8e42-7f70-7000-8000-000000000002",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "fileCount": 2
        }
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
