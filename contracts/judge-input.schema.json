{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/judge-input.schema.json",
  "title": "JudgeInput v2",
  "description": "submission-service → judging-service 的受保护内部读取模型。它与 Submission 同事务创建且永久不可修改，只冻结源码、语言、标定编号和限制；不含测试数据地址，地址由 judging-service 在判题时向 problem-service 取题目当前的值。源码不进入 Kafka；该响应必须通过服务身份鉴权、限制大小并禁止记录 completeSource。CORE 另冻结用户文件（solutionSource = 该语言前缀 + 用户源码，直接拼接；前缀以换行结尾）与前缀行数（前缀中换行符的个数），judging-service 据此把报错中用户文件的行号换算成编辑器行号。",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "contractVersion",
    "problemId",
    "languageId",
    "completeSource",
    "sourceSha256",
    "languageCalibrationId",
    "effectiveLimits",
    "createdAt"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contractVersion": {
      "type": "string",
      "const": "2",
      "description": "用于 judging-service 选择 JudgeRequest 适配器"
    },
    "problemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "languageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "completeSource": {
      "type": "string",
      "description": "ACM 为用户程序；CORE 为驱动文件（题目的驱动代码）"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "completeSource UTF-8 字节的 SHA-256"
    },
    "solutionSource": {
      "type": "string",
      "description": "仅 CORE：用户文件 = 该语言前缀 + 用户源码；ACM 禁止"
    },
    "solutionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "solutionSource UTF-8 字节的 SHA-256"
    },
    "solutionPrefixLineCount": {
      "type": "integer",
      "minimum": 0,
      "description": "冻结时前缀中换行符的个数；用户文件第 n 行对应编辑器第 n - solutionPrefixLineCount 行"
    },
    "languageCalibrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effectiveLimits": {
      "$ref": "judge.schema.json#/definitions/JudgeLimits"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "dependencies": {
    "solutionSource": [
      "solutionSha256",
      "solutionPrefixLineCount"
    ],
    "solutionSha256": [
      "solutionSource"
    ],
    "solutionPrefixLineCount": [
      "solutionSource"
    ]
  },
  "examples": [
    {
      "submissionId": "0198cafe-0000-7000-8000-000000000001",
      "contractVersion": "2",
      "problemId": "0198cafe-0000-7000-8000-000000000002",
      "languageId": "cpp",
      "completeSource": "int main() { return 0; }",
      "sourceSha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "languageCalibrationId": "0198cafe-0000-7000-8000-000000000006",
      "effectiveLimits": {
        "cpuNs": 1000000000,
        "memoryBytes": 268435456
      },
      "createdAt": "2026-08-20T02:00:00Z"
    },
    {
      "submissionId": "0198cafe-0000-7000-8000-000000000011",
      "contractVersion": "2",
      "problemId": "0198cafe-0000-7000-8000-000000000012",
      "languageId": "cpp",
      "completeSource": "#include \"solution.cpp\"\nint main() { int a, b; cin >> a >> b; cout << Solution().add(a, b) << \"\\n\"; }\n",
      "sourceSha256": "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "solutionSource": "#include <bits/stdc++.h>\nusing namespace std;\nclass Solution {\npublic:\n    int add(int a, int b) { return a + b; }\n};\n",
      "solutionSha256": "2123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "solutionPrefixLineCount": 2,
      "languageCalibrationId": "0198cafe-0000-7000-8000-000000000016",
      "effectiveLimits": {
        "cpuNs": 1000000000,
        "memoryBytes": 268435456
      },
      "createdAt": "2026-10-17T02:00:00Z"
    }
  ]
}
