{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/judge-input.schema.json",
  "title": "JudgeInput v2",
  "description": "submission-service → judging-service 的受保护内部读取模型。它与 Submission 同事务创建且永久不可修改。源码不进入 Kafka；该响应必须通过服务身份鉴权、限制大小并禁止记录 completeSource。",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "contractVersion",
    "problemId",
    "problemVersionId",
    "testDataVersionId",
    "languageId",
    "completeSource",
    "sourceSha256",
    "judgeEnvironmentId",
    "environmentFingerprint",
    "languageCalibrationId",
    "effectiveLimits",
    "createdAt"
  ],
  "properties": {
    "submissionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contractVersion": {
      "type": "string",
      "const": "2",
      "description": "用于 judging-service 选择 JudgeRequest 适配器"
    },
    "problemId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "problemVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "testDataVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "languageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "completeSource": {
      "type": "string",
      "description": "ACM 原源码或 CORE 已合并模板后的完整源码"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "completeSource UTF-8 字节的 SHA-256"
    },
    "judgeEnvironmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "environmentFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "languageCalibrationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "effectiveLimits": { "$ref": "judge.schema.json#/definitions/JudgeLimits" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "submissionId": "0198cafe-0000-7000-8000-000000000001",
      "contractVersion": "2",
      "problemId": "0198cafe-0000-7000-8000-000000000002",
      "problemVersionId": "0198cafe-0000-7000-8000-000000000003",
      "testDataVersionId": "0198cafe-0000-7000-8000-000000000004",
      "languageId": "cpp",
      "completeSource": "int main() { return 0; }",
      "sourceSha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "judgeEnvironmentId": "0198cafe-0000-7000-8000-000000000005",
      "environmentFingerprint": "sha256:judge-env-amd64-v1",
      "languageCalibrationId": "0198cafe-0000-7000-8000-000000000006",
      "effectiveLimits": {
        "cpuNs": 1000000000,
        "memoryBytes": 268435456
      },
      "createdAt": "2026-08-20T02:00:00Z"
    }
  ]
}
