{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/submission.json",
  "title": "Submission v2",
  "description": "submission-service 拥有的用户提交读模型。它保存用户原始源码、不可变题目版本、数据版本、环境、标定和绝对限制快照；完整送判源码只存在 JudgeInput。时间单位 ns，内存单位 bytes。",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "problemId",
    "problemVersionId",
    "problemVersionNo",
    "problemTitle",
    "testDataVersionId",
    "userId",
    "languageId",
    "codeMode",
    "languageCalibrationId",
    "judgeEnvironmentId",
    "environmentFingerprint",
    "effectiveLimits",
    "source",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "problemId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "problemVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "problemVersionNo": { "type": "integer", "minimum": 1 },
    "problemTitle": { "type": "string", "minLength": 1, "maxLength": 512 },
    "testDataVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "从登录态取得，不由创建请求指定"
    },
    "languageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "codeMode": { "$ref": "#/definitions/CodeMode" },
    "languageCalibrationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "judgeEnvironmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "environmentFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "effectiveLimits": { "$ref": "judge.schema.json#/definitions/JudgeLimits" },
    "source": {
      "type": "string",
      "description": "用户原始源码；CORE 不含 judgeTemplate"
    },
    "status": { "$ref": "#/definitions/SubmissionStatus" },
    "verdict": {
      "$ref": "verdict.json",
      "description": "DONE 后必填；PENDING/JUDGING 时省略"
    },
    "cpuNs": {
      "type": "integer",
      "minimum": 0,
      "description": "各测试点 CPU 时间最大值"
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "各测试点内存峰值最大值"
    },
    "score": { "type": "integer", "minimum": 0 },
    "message": { "type": "string", "maxLength": 8192 },
    "caseResults": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "judge.schema.json#/definitions/CaseResult" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "CodeMode": {
      "type": "string",
      "enum": ["ACM", "CORE"]
    },
    "SubmissionStatus": {
      "type": "string",
      "description": "PENDING=已冻结并等待调度；JUDGING=至少收到一次 JudgeStarted；DONE=已有终态，不能回退。",
      "enum": ["PENDING", "JUDGING", "DONE"]
    },
    "CreateSubmissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "浏览器创建正式提交。userId、版本、环境和限制均由服务端解析。",
      "required": ["problemId", "languageId", "source"],
      "properties": {
        "problemId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "languageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "source": { "type": "string" }
      },
      "examples": [
        {
          "problemId": "0198cafe-0000-7000-8000-000000000002",
          "languageId": "cpp",
          "source": "int main() { return 0; }"
        }
      ]
    }
  }
}
