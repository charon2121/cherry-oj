{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cherry-oj.dev/schema/calibration.schema.json",
  "title": "Calibration internal v1",
  "description": "problem-service → judging-service 的标定与就绪检查内部接口，需要 problem-service 的调用令牌，并带 ADMIN 用户（docs/protocols/service-identity.md）。POST /internal/admin/calibrations：请求体 CalibrationRequest，响应 Calibration；GET /internal/admin/readiness?problemId=&languageId=&testDataDigest=&maxTestcaseIoBytes=：响应 Readiness；maxTestcaseIoBytes 由 problem-service 从当前测试数据读出，推导限制时用。GET /internal/admin/limits?problemId=&testDataDigest=&maxTestcaseIoBytes=&languageIds=cpp&languageIds=...：响应 LanguageLimitsList；languageIds 由 problem-service 给出题目开放的语言（judging-service 不知道题目开放了哪些语言），1–32 个且不重复，否则 400。时间均为 UTC，序列化为不带时区后缀的 ISO-8601 本地时间（微秒精度）。参考源码只用于本次标定，不得写入日志。cpuNs、memoryBytes 超过 judging-service 的平台上限时返回 400（docs/protocols/limits.md）。 新增 POST /internal/problems/readiness：请求 ProblemReadinessRequest，响应 ProblemReadiness。仅允许 problem-service 的服务身份，不要求用户；供公开作答页查询就绪语言，不能伪造 ADMIN 用户。缺失或非法字段、重复语言返回 400；无在线节点或无可用标定不是接口故障，仍为 200、对应 ready=false。它是只读查询，不运行程序、不创建标定，所有响应 no-store。现有 /internal/admin/** 的 ADMIN 要求不变。",
  "x-contract-version": 1,
  "definitions": {
    "CalibrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "testDataLocation 与 testDataDigest 是 problem-service 此刻给出的；判题结果里的数据指纹必须与 testDataDigest 一致，否则标定作废。",
      "required": [
        "problemId",
        "languageId",
        "kind",
        "testDataLocation",
        "testDataDigest",
        "cpuNs",
        "memoryBytes",
        "clockNs",
        "referenceSource"
      ],
      "properties": {
        "problemId": {
          "type": "string",
          "format": "uuid"
        },
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "kind": {
          "$ref": "#/definitions/CalibrationKind"
        },
        "testDataLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "testDataDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cpuNs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "clockNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "referenceSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "description": "ACM 为完整参考程序；CORE 为驱动文件（题目的驱动代码）"
        },
        "referenceSolutionSource": {
          "type": "string",
          "minLength": 1,
          "description": "仅 CORE：参考用户文件 = 该语言前缀 + 参考核心代码"
        },
        "solutionPrefixLineCount": {
          "type": "integer",
          "minimum": 0,
          "description": "仅 CORE：前缀中换行符的个数，用于换算标定失败消息中的用户文件行号"
        }
      },
      "dependencies": {
        "referenceSolutionSource": [
          "solutionPrefixLineCount"
        ],
        "solutionPrefixLineCount": [
          "referenceSolutionSource"
        ]
      },
      "examples": [
        {
          "problemId": "0198cafe-0000-7000-8000-000000000012",
          "languageId": "cpp",
          "kind": "BASE",
          "testDataLocation": "/srv/cherry-oj/testdata/0198cafe-0000-7000-8000-000000000012",
          "testDataDigest": "6c67e6d15542f93808352ac2b692f3772e1243d09bd34b2366b9b212345a07e4",
          "cpuNs": 1000000000,
          "memoryBytes": 268435456,
          "clockNs": null,
          "referenceSource": "#include \"solution.cpp\"\nint main() { int a, b; cin >> a >> b; cout << Solution().add(a, b) << \"\\n\"; }\n",
          "referenceSolutionSource": "#include <bits/stdc++.h>\nusing namespace std;\nclass Solution {\npublic:\n    int add(int a, int b) { return a + b; }\n};\n",
          "solutionPrefixLineCount": 2
        }
      ]
    },
    "CalibrationKind": {
      "type": "string",
      "enum": [
        "BASE",
        "OVERRIDE"
      ],
      "description": "BASE=基础标定：每题每个测试数据指纹最多一条 VALID，语言必须可作基础（contracts/languages.json 的 baseEligible）；OVERRIDE=覆盖标定：取代该语言的推导值，不能用于当前基础语言。见 docs/protocols/limits.md"
    },
    "CalibrationStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RUNNING",
        "VALID",
        "FAILED",
        "SUPERSEDED"
      ]
    },
    "BenchmarkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "verdict"
      ],
      "properties": {
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "参考源码 UTF-8 字节的 SHA-256；CORE 为驱动文件"
        },
        "verdict": {
          "$ref": "verdict.json"
        },
        "maxCpuNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxMemoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxClockNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "problemId",
        "languageId",
        "kind",
        "status",
        "cpuNs",
        "memoryBytes",
        "clockNs",
        "testDataDigest",
        "benchmarkSummary",
        "errorMessage",
        "createdAt",
        "updatedAt",
        "rowVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "problemId": {
          "type": "string",
          "format": "uuid"
        },
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "kind": {
          "$ref": "#/definitions/CalibrationKind"
        },
        "status": {
          "$ref": "#/definitions/CalibrationStatus"
        },
        "cpuNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "memoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "clockNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "testDataDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "benchmarkSummary": {
          "anyOf": [
            {
              "$ref": "#/definitions/BenchmarkSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8192,
          "description": "FAILED 时必填；CORE 时用户文件行号已按前缀换算"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "rowVersion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ReadinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "passed",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ONLINE_JUDGE_NODE",
            "LANGUAGE",
            "CALIBRATION",
            "LIMIT_MODEL"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ExecutionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrationId",
        "cpuNs",
        "memoryBytes",
        "clockNs",
        "limitSource",
        "limitDerivation",
        "calibratedAt"
      ],
      "properties": {
        "calibrationId": {
          "type": "string",
          "format": "uuid",
          "description": "依据的标定编号：BASE、OVERRIDE 为该标定本身，DERIVED 为题目的基础标定"
        },
        "cpuNs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "clockNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "limitSource": {
          "$ref": "execution-profile.schema.json#/definitions/LimitSource"
        },
        "limitDerivation": {
          "anyOf": [
            {
              "$ref": "execution-profile.schema.json#/definitions/LimitDerivation"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibratedAt": {
          "type": "string",
          "description": "这条 VALID 标定的批准时间；problem-service 与驱动代码、前缀的修改时间比较，晚于它时提示重新标定"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "limitSource": {
                "const": "DERIVED"
              }
            }
          },
          "then": {
            "properties": {
              "limitDerivation": {
                "$ref": "execution-profile.schema.json#/definitions/LimitDerivation"
              }
            }
          },
          "else": {
            "properties": {
              "limitDerivation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "checks",
        "executionProfile"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReadinessCheck"
          }
        },
        "executionProfile": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExecutionProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "ready 时为该语言解析出的限制（覆盖标定、基础标定或推导值），否则为 null"
        }
      }
    },
    "LanguageLimits": {
      "type": "object",
      "additionalProperties": false,
      "description": "一门语言在这道题上的限制及其来源（docs/protocols/limits.md），管理端标定页用。不要求有在线节点：这里只回答“限制是多少、从哪来”。解析不出限制时 limitSource 与各限制为 null，unavailableReason 给出原因。",
      "required": [
        "languageId",
        "limitSource",
        "cpuNs",
        "memoryBytes",
        "clockNs",
        "calibrationId",
        "cpuCapped",
        "memoryCapped",
        "unavailableReason"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "limitSource": {
          "anyOf": [
            {
              "$ref": "execution-profile.schema.json#/definitions/LimitSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpuNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "memoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "clockNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "calibrationId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "依据的标定编号：DERIVED 时是基础标定"
        },
        "cpuCapped": {
          "type": "boolean",
          "description": "推导值超过平台上限、已截断；非推导时为 false"
        },
        "memoryCapped": {
          "type": "boolean"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NO_CALIBRATION",
            "NO_LIMIT_MODEL",
            "BASE_LIMIT_MODEL_REMOVED",
            null
          ],
          "description": "NO_CALIBRATION=既没有对应当前数据的覆盖标定，也没有对应当前数据的基础标定；NO_LIMIT_MODEL=需要推导但该语言没有限制参数，只能做覆盖标定；BASE_LIMIT_MODEL_REMOVED=基础语言的参数已从语言目录移除，要重新做基础标定"
        }
      }
    },
    "LanguageLimitsList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageLimits"
          },
          "description": "顺序与请求里的 languageIds 一致"
        }
      }
    },
    "ProblemReadinessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemId",
        "testDataDigest",
        "maxTestcaseIoBytes",
        "languageIds"
      ],
      "properties": {
        "problemId": {
          "type": "string",
          "format": "uuid"
        },
        "testDataDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maxTestcaseIoBytes": {
          "type": "integer",
          "minimum": 0
        },
        "languageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "uniqueItems": true
        }
      }
    },
    "ProblemLanguageReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "ready",
        "checks"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/ReadinessCheck"
          }
        }
      }
    },
    "ProblemReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/ProblemLanguageReadiness"
          }
        }
      },
      "description": "每个请求 languageId 恰好一行，顺序与请求一致；计算规则与现有管理员 readiness 完全相同。只返回就绪事实，不返回 ExecutionProfile、参考源码或数据地址。"
    }
  }
}
