{
  "schemaVersion": 1,
  "name": "cherry-oj-web-design-system",
  "version": "3.0.0",
  "entrypoints": {
    "documentation": "README.md",
    "tokens": "tokens.css",
    "valueAnchor": "design-tokens.json",
    "tailwind": "tailwind-v4.css",
    "themeContract": "theme-contract.json",
    "themeManifest": "themes.manifest.json"
  },
  "managedFiles": [
    {
      "registry": "themes.manifest.json",
      "selector": "themes[].file",
      "role": "complete registered theme sources"
    }
  ],
  "files": [
    { "path": "manifest.json", "role": "Web design-system package file registry" },
    { "path": "README.md", "role": "Web design-system maintenance boundary" },
    { "path": "LICENSE.fonts", "role": "Inter and JetBrains Mono OFL-1.1 notices" },
    { "path": "NOTICE.md", "role": "third-party font and icon attribution notice" },
    { "path": "tokens.foundation.css", "role": "shared typography, spacing, radius, and motion tokens" },
    { "path": "theme-contract.json", "role": "semantic theme and contrast contract" },
    { "path": "themes.manifest.json", "role": "theme registry and light-first default" },
    { "path": "tokens.css", "role": "generated stable CSS entrypoint", "generated": true },
    { "path": "design-tokens.json", "role": "generated value anchor for Foundation and both themes", "generated": true },
    { "path": "tailwind-v4.css", "role": "theme-neutral Tailwind v4 and shadcn adapter" },
    { "path": "tools/build.mjs", "role": "deterministic CSS and token-anchor builder" },
    { "path": "tools/check.mjs", "role": "runtime contract, WCAG contrast, and package verifier" }
  ]
}
