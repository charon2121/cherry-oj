[Unit]
Description=Cherry OJ command API with the setuid isolated executor

[Service]
Type=exec
Slice=cherry-sandbox.slice
ExecStartPre=/usr/bin/test -f /etc/cherry-sandbox/sandbox.json
# 启动脚本核对 rootfs 与清单逐文件一致，建好委派子树（supervisor/jobs），再 exec 服务本体。
ExecStart=/usr/bin/python3 /etc/cherry-sandbox/sandbox-start.py /etc/cherry-sandbox/sandbox-start.json
User=cherry-sandbox
Group=cherry-sandbox
UMask=0077
Delegate=cpu memory pids
KillMode=control-group
TimeoutStopSec=15s
Restart=no
MemoryMax=896M
MemorySwapMax=0
TasksMax=224
CPUQuota=150%
CPUQuotaPeriodSec=100ms
# 服务进程本身非 root、没有任何有效能力。边界集只为 setuid-root 的执行器保留它必需的 8 项能力；
# 执行器用完即全部丢弃，用户程序与 init 都拿不到。
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_DAC_OVERRIDE CAP_MKNOD CAP_KILL
# 执行器靠 setuid 取得特权，因此这里不能设置 NoNewPrivileges，也不能设置任何对非 root 服务
# 隐含 NoNewPrivileges 的选项（RestrictAddressFamilies、LockPersonality、ProtectKernel*、
# RestrictSUIDSGID、RestrictNamespaces 等基于 seccomp 的硬化）；cgroupfs 也必须可写。
ProtectSystem=strict
ReadWritePaths=/var/lib/cherry-sandbox/service /sys/fs/cgroup/cherry.slice/cherry-sandbox.slice/cherry-sandbox.service
ProtectHome=yes
PrivateTmp=yes
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
