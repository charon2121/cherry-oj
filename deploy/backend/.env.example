# Copy to .env (ignored). Supply actual values; no credentials are provided here.
BACKEND_PROFILE=dev
BACKEND_TAG=local
GATEWAY_PORT=8080
WEB_ORIGIN=http://localhost:5173
SESSION_SECURE=false
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
CUSTOM_RUN_ENABLED=false
FORMAL_ENABLED=false
# 服务身份密钥目录（绝对路径）：scripts/service-identity-keys.sh <目录> 生成，五个服务的私钥与公钥目录 public/。
SERVICE_IDENTITY_DIR=
JUDGE_CONTROL_TOKEN=
USER_DB_URL=jdbc:mysql://host.docker.internal:3306/cherry_oj_user
USER_DB_USERNAME=cherry_oj_user
USER_DB_PASSWORD=
PROBLEM_DB_URL=jdbc:mysql://host.docker.internal:3306/cherry_oj_problem
PROBLEM_DB_USERNAME=cherry_oj_problem
PROBLEM_DB_PASSWORD=
SUBMISSION_DB_URL=jdbc:mysql://host.docker.internal:3306/cherry_oj_submission
SUBMISSION_DB_USERNAME=cherry_oj_submission
SUBMISSION_DB_PASSWORD=
JUDGING_DB_URL=jdbc:mysql://host.docker.internal:3306/cherry_oj_judging
JUDGING_DB_USERNAME=cherry_oj_judging
JUDGING_DB_PASSWORD=
