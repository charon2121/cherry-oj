{
  "schemaVersion": 1,
  "provenance": {
    "designSystem": "Cherry OJ Native Design System v3.0 (Modern Light-First Card & Island Workspace)",
    "executableRoot": "../../apps/web/design-system",
    "license": "Proprietary / Repository License"
  },
  "contractVersion": "3.0.0",
  "themeCoverage": "all-registered",
  "sourceOfTruth": "../design-system.md",
  "reference": {
    "kind": "storybook",
    "command": "cd apps/web && npm run storybook",
    "note": "视觉与交互参考由 Storybook 承担，直接渲染 apps/web/src/components/ui 下的真实生产组件。"
  },
  "globalRules": {
    "defaultTheme": "pure-white",
    "themeBranching": "forbidden",
    "rawColors": "forbidden",
    "focus": "Use --ds-focus on :focus-visible with a 1px outline and -1px/0px offset so focus never shifts layout.",
    "status": "Pair every semantic color with a readable code, Chinese label, icon, or distinct geometric shape.",
    "motion": "Use 150ms/200ms foundation durations; subtle scale/translate transitions are reserved for overlays and collapse to 0s under prefers-reduced-motion.",
    "icons": "Use Lucide React; decorative icons are aria-hidden and icon-only controls require an accessible Chinese name."
  },
  "components": [
    {
      "id": "button",
      "category": "action",
      "anatomy": ["control", "label", "optional-icon", "optional-progress-label"],
      "sizes": ["sm", "md", "lg"],
      "variants": ["primary", "secondary", "ghost", "subtle", "toolbar", "danger"],
      "states": ["default", "hover", "pressed", "focus-visible", "disabled", "loading"],
      "tokenReferences": [
        "--ds-brand-surface",
        "--ds-brand-surface-hover",
        "--ds-brand-surface-active",
        "--ds-on-brand",
        "--ds-surface",
        "--ds-surface-hover",
        "--ds-surface-subtle",
        "--ds-surface-translucent",
        "--ds-fg",
        "--ds-fg-2",
        "--ds-fg-disabled",
        "--ds-border-solid",
        "--ds-elevation-subtle",
        "--ds-danger-solid",
        "--ds-danger-on-solid",
        "--ds-focus"
      ],
      "keyboard": [
        "Tab focuses enabled controls",
        "Enter and Space activate",
        "Disabled and loading controls do not activate"
      ],
      "constraints": [
        "Never use brand styling for a destructive action",
        "Loading preserves width and exposes readable status text"
      ],
      "implementation": "apps/web/src/components/ui/button.tsx"
    },
    {
      "id": "pill",
      "category": "filter",
      "anatomy": ["optional-dot", "label"],
      "sizes": ["sm"],
      "variants": ["static", "interactive"],
      "states": ["default", "hover", "selected", "focus-visible"],
      "tokenReferences": [
        "--ds-surface",
        "--ds-surface-hover",
        "--ds-surface-translucent-selected",
        "--ds-fg",
        "--ds-fg-2",
        "--ds-border-solid",
        "--ds-border-strong",
        "--ds-focus"
      ],
      "keyboard": [
        "Interactive pills render a native button with aria-pressed",
        "Enter and Space activate"
      ],
      "constraints": [
        "Never attach button behavior to a span",
        "Dots are decorative unless a visible label explains their meaning"
      ],
      "implementation": "apps/web/src/components/ui/pill.tsx"
    },
    {
      "id": "field",
      "category": "form",
      "anatomy": ["label", "control", "optional-description", "optional-error"],
      "sizes": ["sm", "md"],
      "variants": ["input", "search", "textarea", "select"],
      "states": ["default", "hover", "focus-visible", "disabled", "invalid"],
      "tokenReferences": [
        "--ds-surface",
        "--ds-surface-hover",
        "--ds-surface-translucent",
        "--ds-fg",
        "--ds-fg-meta",
        "--ds-fg-disabled",
        "--ds-border-solid",
        "--ds-focus",
        "--ds-danger-foreground",
        "--ds-danger-border"
      ],
      "keyboard": [
        "Native control order is preserved",
        "Label activates its control",
        "Error text is referenced with aria-describedby"
      ],
      "constraints": [
        "Placeholder is not a label",
        "Do not lower placeholder or disabled text opacity"
