{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherry-oj.local/schemas/product-requirement.schema.json",
  "title": "cherry-oj product requirement metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "product_area",
    "milestone",
    "priority",
    "status",
    "owner",
    "reviewer",
    "target_users",
    "source_prd",
    "related_requirements",
    "related_decisions",
    "delivery_tasks",
    "created_at",
    "updated_at",
    "accepted_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^REQ-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "product_area": { "type": "string", "minLength": 1 },
    "milestone": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "status": {
      "enum": [
        "draft",
        "product_review",
        "ready",
        "delivering",
        "product_acceptance",
        "accepted",
        "released",
        "paused",
        "cancelled"
      ]
    },
    "owner": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "target_users": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_prd": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "related_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REQ-[0-9]{4}$" }
    },
    "related_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^PD-[0-9]{4}$" }
    },
    "delivery_tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": ["string", "null"], "format": "date-time" }
  }
}

