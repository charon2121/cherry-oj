{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherry-oj.local/schemas/product-decision.schema.json",
  "title": "cherry-oj product decision metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "related_requirements",
    "created_at",
    "updated_at",
    "accepted_at",
    "superseded_by"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^PD-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "accepted", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "related_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REQ-[0-9]{4}$" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": ["string", "null"], "format": "date-time" },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^PD-[0-9]{4}$"
    }
  }
}
