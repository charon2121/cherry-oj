class WorkError(Exception):
    """可以直接展示给用户的工作项错误。"""


@dataclass
class Document:
    path: Path
    metadata: dict[str, Any]
    body: str

    @property
    def id(self) -> str:
        value = self.metadata.get("id")
        return value if isinstance(value, str) else self.path.stem

    @property
    def kind(self) -> str:
        value = self.metadata.get("type")
        return value if isinstance(value, str) else ""


def today() -> str:
    return date.today().isoformat()


def parse_document(path: Path) -> Document:
    content = path.read_text(encoding="utf-8")
    if not content.startswith("---\n"):
        raise WorkError(f"{path}: 缺少起始 front matter 分隔符")
    end = content.find("\n---\n", 4)
    if end < 0:
        raise WorkError(f"{path}: 缺少结束 front matter 分隔符")
    metadata: dict[str, Any] = {}
    for line_number, raw_line in enumerate(content[4:end].splitlines(), start=2):
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        if raw_line[:1].isspace() or ":" not in raw_line:
            raise WorkError(
                f"{path}:{line_number}: front matter 只允许每行一个 `字段: JSON值`"
            )
        key, raw_value = raw_line.split(":", 1)
        key = key.strip()
        if key in metadata:
            raise WorkError(f"{path}:{line_number}: 字段 {key} 重复")
        try:
            metadata[key] = json.loads(raw_value.strip())
        except json.JSONDecodeError as error:
            raise WorkError(
                f"{path}:{line_number}: {key} 必须使用 JSON 兼容值：{error.msg}"
            ) from error
    document = Document(path=path, metadata=metadata, body=content[end + 5 :])
    if document.kind == "work":
        # 控制面是工具维护的机器状态，不放进人编辑的 front matter：
        # 它是一行两千多字符的 JSON，改一个阶段状态就整行变更，diff 完全不可读。
        flow_path = path.parent / FLOW_FILENAME
        if flow_path.is_file():
            try:
                document.metadata["workflow"] = json.loads(flow_path.read_text(encoding="utf-8"))
            except json.JSONDecodeError as error:
                raise WorkError(f"{flow_path}: 无法解析控制面状态：{error.msg}") from error
    return document


def render_document(document: Document) -> str:
    preferred = (
        "id",
        "type",
        "title",
        "status",
        "work",
        "owners",
        "risk",
        "impact",
        "concerns",
        "depends_on",
        "related",
        "implements",
        "verifies",
        "supersedes",
        "deprecated",
        "tags",
        "workflow",
        "required_documents",
        "required_checks",
        "human_confirmations",
        "gates",
        "blocking_items",
        "reversible",
        "data_change",
        "public_api_change",
        "security_sensitive",
        "user_visible",
        "read_paths",
        "write_paths",
        "forbidden_paths",
        "result",
        "created_at",
        "updated_at",
    )
    lines = ["---"]
    skip = {"workflow"} if document.kind == "work" else set()
    for field in preferred:
        if field in document.metadata and field not in skip:
            lines.append(f"{field}: {json.dumps(document.metadata[field], ensure_ascii=False)}")
    for field in sorted(set(document.metadata) - set(preferred) - skip):
        lines.append(f"{field}: {json.dumps(document.metadata[field], ensure_ascii=False)}")
    lines.extend(("---", "", document.body.strip(), ""))
    return "\n".join(lines)


def write_document(document: Document) -> None:
    document.path.parent.mkdir(parents=True, exist_ok=True)
    if document.kind == "work":
        write_json(document.path.parent / FLOW_FILENAME, document.metadata.get("workflow", []))
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=document.path.parent,
        prefix=f".{document.path.name}.",
        delete=False,
    ) as temporary:
        temporary.write(render_document(document))
        temporary_path = Path(temporary.name)
    temporary_path.replace(document.path)


def load_index(root: Path) -> dict[str, Any]:
    path = root / "development" / "index.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise WorkError(f"缺少编号注册表：{path}") from error
    except json.JSONDecodeError as error:
        raise WorkError(f"{path}: JSON 解析失败：{error}") from error
    if not isinstance(value, dict) or not isinstance(value.get("next_ids"), dict):
        raise WorkError(f"{path}: 必须包含 next_ids 对象")
    return value


def write_json(path: Path, payload: Any) -> None:
    """原子写入：中途失败不会留下半份状态文件。"""
    path.parent.mkdir(parents=True, exist_ok=True)
    content = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as temporary:
        temporary.write(content)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


def write_index(root: Path, index: dict[str, Any]) -> None:
    path = root / "development" / "index.json"
    content = json.dumps(index, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, prefix=".index.json.", delete=False
    ) as temporary:
        temporary.write(content)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


