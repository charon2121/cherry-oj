def markdown_cell(value: object) -> str:
    return str(value).replace("|", "\\|").replace("\n", " ")


def work_index_sort_key(document: Document) -> tuple[int, str]:
    match = ID_PATTERN.fullmatch(document.id)
    return (int(match.group(2)), document.id) if match else (sys.maxsize, document.id)


def render_works_index(documents: dict[str, Document]) -> str:
    works = sorted(
        (document for document in documents.values() if document.kind == "work"),
        key=work_index_sort_key,
    )
    lines = [
        "# 工作项总览",
        "",
        "这里集中列出项目中的全部工作项，方便不阅读技术细节也能快速了解项目正在做什么、做到哪里。",
        "详细背景、成功标准和风险请打开每行的 `00-work.md`。本页由 `scripts/work` 维护，不手工修改。",
        "",
        "| 编号 | 工作内容 | 类型 | 状态 | 风险 | 影响面 | 负责人 | 详细说明 |",
        "|---|---|---|---|---|---|---|---|",
    ]
    for work in works:
        metadata = work.metadata
        owners = "、".join(metadata.get("owners", []))
        link = f"[00-work.md](./works/{work.id}/00-work.md)"
        cells = (
            work.id,
            metadata.get("title", ""),
            WORK_TYPE_LABELS.get(str(metadata.get("work_type")), metadata.get("work_type", "")),
            (
                WORK_STATUS_LABELS.get(str(metadata.get("status")), metadata.get("status", ""))
                + (f" · {outcome_summary(work)}" if work_outcome(work) else "")
            ),
            RISK_LABELS.get(str(metadata.get("risk")), metadata.get("risk", "")),
            IMPACT_LABELS.get(str(metadata.get("impact")), metadata.get("impact", "")),
            owners,
            link,
        )
        lines.append("| " + " | ".join(markdown_cell(cell) for cell in cells) + " |")
    return "\n".join(lines) + "\n"


def sync_works_index(root: Path, documents: dict[str, Document]) -> None:
    path = root / "development" / "WORKS.md"
    content = render_works_index(documents)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, prefix=".WORKS.md.", delete=False
    ) as temporary:
        temporary.write(content)
        temporary_path = Path(temporary.name)
    temporary_path.replace(path)


def validate_works_index(root: Path, documents: dict[str, Document]) -> list[str]:
    path = root / "development" / "WORKS.md"
    if not path.is_file():
        return ["development/WORKS.md: 缺少项目工作项总览，请运行 scripts/work sync-works"]
    if path.read_text(encoding="utf-8") != render_works_index(documents):
        return ["development/WORKS.md: 内容与工作项不一致，请运行 scripts/work sync-works"]
    return []


def is_settled(document: "Document") -> bool:
    """文档是否已定稿：人签字的 approved 或工具校验通过的 checked。"""
    return document.metadata.get("status") in SETTLED_DOCUMENT_STATUSES


def pending_gates(work: "Document", documents: dict[str, "Document"]) -> list[str]:
    """还等着人签的闸。两闸制之后，这是系统里唯一的人工确认点。"""
    return [
        gate
        for gate in GATE_NAMES
        if not gate_passed(work, gate) and gate_covered_documents(work.id, documents, gate)
    ]


def check_name(check: Any) -> str:
    """兼容两种形态：迁移前 checks 是字符串列表，迁移后是带结论的对象。"""
    return check["name"] if isinstance(check, dict) else str(check)


def check_result(check: Any) -> str:
    return check.get("result", "unrecorded") if isinstance(check, dict) else "unrecorded"


def work_outcome(work: "Document") -> dict[str, Any] | None:
    """结论是否仍然成立。缺省即成立。"""
    outcome = work.metadata.get("outcome")
    return outcome if isinstance(outcome, dict) else None


def outcome_summary(work: "Document") -> str:
    outcome = work_outcome(work)
    if outcome is None:
        return ""
    label = OUTCOME_LABELS.get(outcome.get("state"), outcome.get("state", ""))
    return f"{label} {outcome['by']}" if outcome.get("by") else label


def gate_kinds(gate: str) -> set[str]:
    return INTENT_GATE_KINDS if gate == "intent" else ACCEPTANCE_GATE_KINDS


def work_gates(work: "Document") -> dict[str, str]:
    """读取工作项的两道闸；缺失时按未通过处理，便于旧文档平滑过渡。"""
    gates = work.metadata.get("gates")
    if not isinstance(gates, dict):
        gates = {}
    return {name: gates.get(name, "pending") for name in GATE_NAMES}


def gate_passed(work: "Document", gate: str) -> bool:
    return work_gates(work).get(gate) == "passed"


def discover_paths(root: Path) -> list[Path]:
    return sorted((root / "development" / "works").glob("WORK-*/*.md"))


def validate_repository_layout(root: Path) -> list[str]:
    errors: list[str] = []
    development = root / "development"
    for entry in development.iterdir():
        if entry.name.startswith("."):
            continue
        if entry.name not in ALLOWED_DEVELOPMENT_ENTRIES:
            errors.append(
                f"development/{entry.name}: development 顶层只允许全局入口、模板、Schema 和 works/"
            )
    works = development / "works"
    if not works.exists():
        return errors
    for entry in works.iterdir():
        relative = entry.relative_to(root)
        if not entry.is_dir():
            errors.append(f"{relative}: works/ 下只能放 WORK-001 形式的工作项目录")
            continue
        if WORK_DIRECTORY_PATTERN.fullmatch(entry.name) is None:
            errors.append(f"{relative}: 工作项目录名必须匹配 WORK-001")
            continue
        for child in entry.iterdir():
            if child.name.startswith("."):
                continue
            if child.name == FLOW_FILENAME and child.is_file():
                continue
            if child.is_dir() or child.suffix != ".md":
                errors.append(
                    f"{child.relative_to(root)}: 工作项目录必须保持扁平，"
                    f"只包含受管理的 Markdown 文档与工具维护的 {FLOW_FILENAME}"
                )
    return errors


def load_documents(root: Path) -> dict[str, Document]:
    documents: dict[str, Document] = {}
    for path in discover_paths(root):
        document = parse_document(path)
        if document.id in documents:
            raise WorkError(
                f"文档 ID 重复：{document.id} 同时出现在 {documents[document.id].path} 和 {path}"
            )
        documents[document.id] = document
    return documents


def section(body: str, title: str) -> str | None:
    match = re.search(rf"(?ms)^## {re.escape(title)}\n+(.*?)(?=^## |\Z)", body)
    return match.group(1).strip() if match else None


def replace_section(body: str, title: str, value: str) -> str:
    pattern = re.compile(rf"(?ms)(^## {re.escape(title)}\n+).*?(?=^## |\Z)")
    if not pattern.search(body):
        return body.rstrip() + f"\n\n## {title}\n\n{value.strip()}\n"
    return pattern.sub(rf"\g<1>{value.strip()}\n\n", body, count=1).rstrip() + "\n"


def append_log(document: Document, message: str) -> None:
    title = "执行记录" if document.kind == "task" else "变更记录"
    current = section(document.body, title)
    entry = f"- {today()}：{message}"
    if current and current not in {"无。", "暂无。"}:
        entry = f"{current}\n{entry}"
    document.body = replace_section(document.body, title, entry)


def checkbox_state(body: str, title: str) -> tuple[int, int]:
    content = section(body, title) or ""
    markers = re.findall(r"(?m)^\s*- \[([ xX])\] ", content)
    return len(markers), sum(marker.lower() == "x" for marker in markers)


def allocate_id(index: dict[str, Any], kind: str) -> str:
    next_ids = index["next_ids"]
    number = next_ids.get(kind)
    if not isinstance(number, int) or number < 1:
        raise WorkError(f"index.json 中 {kind} 的下一个编号无效")
    next_ids[kind] = number + 1
    prefix, _ = TYPE_CONFIG[kind]
    return f"{prefix}-{number:03d}"


def effective_risk(
    requested: str,
    concerns: Iterable[str],
    reversible: bool,
    data_change: bool,
    public_api_change: bool,
    security_sensitive: bool,
) -> str:
    minimum = "low"
    if set(concerns) & RISKY_CONCERNS or data_change or public_api_change or security_sensitive:
        minimum = "medium"
    if not reversible:
        minimum = "high"
    return max((requested, minimum), key=RISK_RANK.__getitem__)


def select_workflow(metadata: dict[str, Any]) -> dict[str, Any]:
    kind = metadata["type"]
    risk = metadata["risk"]
    impact = metadata["impact"]
    concerns = set(metadata["concerns"])
    fast = (
        risk == "low"
        and impact == "local"
        and metadata["reversible"]
        and not metadata["data_change"]
        and not metadata["public_api_change"]
        and not metadata["security_sensitive"]
        and not concerns.intersection(RISKY_CONCERNS)
    )
    stages = [
        {
            "stage": stage,
            "label": label,
            "document_type": document_type,
            "requirement": "required" if required else "optional",
            "fast_skippable": fast_skippable,
            "source": f"profile:{kind}",
            "reason": f"{kind} 基础流程",
        }
        for stage, label, document_type, required, fast_skippable in WORKFLOW_PROFILES[kind]
    ]

    def stage_named(name: str) -> dict[str, Any] | None:
        return next((stage for stage in stages if stage["stage"] == name), None)

    def require_stage(name: str, reason: str, source: str) -> None:
        stage = stage_named(name)
        if stage is None:
            raise WorkError(f"{kind} 流程缺少可升级的 {name} 阶段")
        stage["requirement"] = "required"
        stage["source"] = source
        stage["reason"] = reason

    def insert_stage(
        after: str,
        name: str,
        label: str,
        document_type: str | None,
        reason: str,
        source: str,
    ) -> None:
        if stage_named(name) is not None:
            require_stage(name, reason, source)
            return
        index = next(index for index, stage in enumerate(stages) if stage["stage"] == after)
        stages.insert(
            index + 1,
            {
                "stage": name,
                "label": label,
                "document_type": document_type,
                "requirement": "required",
                "fast_skippable": False,
                "source": source,
                "reason": reason,
            },
        )

    if kind == "fix" and (risk in {"high", "critical"} or impact != "local"):
        require_stage("design", "复杂修复需要独立确认原因与修复方案", "overlay:fix-complexity")

    if fast:
        for stage in stages:
            if stage["fast_skippable"]:
                stage["requirement"] = "optional"
                stage["source"] = "overlay:fast"
                stage["reason"] = "低风险、局部、可回退工作采用快速流程"

    if risk in {"high", "critical"} or impact == "system":
        require_stage("design", "高风险或系统级影响必须有独立技术方案", "overlay:risk-impact")
        if stage_named("plan") is None:
            insert_stage(
                "design",
                "plan",
                "开发计划",
                "plan",
                "高风险或系统级影响必须有显式实施计划",
                "overlay:risk-impact",
            )
        else:
            require_stage("plan", "高风险或系统级影响必须有显式实施计划", "overlay:risk-impact")
        insert_stage(
            "design",
            "decision",
            "技术决策",
            "decision",
            "高风险或系统级影响需要可长期追踪的技术决定",
            "overlay:risk-impact",
        )
        require_stage("memory", "高风险或系统级工作必须沉淀长期记忆", "overlay:risk-impact")

    document_order = {
        value: index
        for index, value in enumerate(
            (
                "product",
                "feature",
                "capability",
                "issue",
                "change",
                "improvement",
                "experience",
                "design",
                "decision",
                "plan",
                "task",
                "verify",
                "memory",
            )
        )
    }
    required_documents = list(
        dict.fromkeys(
            stage["document_type"]
            for stage in stages
            if stage["requirement"] == "required" and stage["document_type"] is not None
        )
    )
    required_documents.sort(key=document_order.__getitem__)

    required_checks = ["definition", "scope", "automated-tests"]
    if risk != "low" or impact != "local":
        required_checks.append("impact-analysis")
    if risk in {"high", "critical"}:
        required_checks.extend(("independent-review", "rollback"))
    if impact == "system":
        required_checks.append("cross-module-regression")
    required_checks.extend(sorted(concerns))

    checks_by_stage: dict[str, list[str]] = defaultdict(list)
    checks_by_stage["definition"].extend(("definition", "scope"))
    checks_by_stage["verification"].append("automated-tests")
    for check in required_checks:
        if check in {"definition", "scope", "automated-tests"}:
            continue
        if check in {"impact-analysis", "independent-review"}:
            checks_by_stage["review"].append(check)
        elif check in {"rollback", "release"}:
            # 没有独立上线阶段后，回退与交付方式在计划阶段确定。
            checks_by_stage["plan"].append(check)
        else:
            checks_by_stage["verification"].append(check)

    workflow = []
    for stage in stages:
        skipped = stage["requirement"] == "optional" and stage["document_type"] is not None
        workflow.append(
            {
                "stage": stage["stage"],
                "label": stage["label"],
                "requirement": stage["requirement"],
                "status": "skipped" if skipped else "pending",
                "status_source": "derived",
                "artifacts": [],
                "checks": [
                    {"name": name, "result": "pending", "note": ""}
                    for name in dict.fromkeys(checks_by_stage[stage["stage"]])
                ],
                "source": stage["source"],
                "reason": stage["reason"],
            }
        )
    return {
        "workflow": workflow,
        "required_documents": required_documents,
        "required_checks": list(dict.fromkeys(required_checks)),
        "fast": fast,
    }


def template_body(root: Path, kind: str, document_id: str, title: str) -> str:
    path = root / "development" / "templates" / f"{kind}.md"
    try:
        template = path.read_text(encoding="utf-8")
    except FileNotFoundError as error:
        raise WorkError(f"缺少模板：{path}") from error
    return template.replace("{{id}}", document_id).replace("{{title}}", title).replace(
        "{{date}}", today()
    )


def work_directory_path(root: Path, work_id: str) -> Path:
    return root / "development" / "works" / work_id


def document_filename(kind: str, document_id: str) -> str:
    _, level = TYPE_CONFIG[kind]
    if kind == "work":
        return f"{level}-work.md"
    return f"{level}-{kind}-{document_id}.md"


def document_path(work_directory: Path, kind: str, document_id: str) -> Path:
    return work_directory / document_filename(kind, document_id)


def stages_for_document(document: Document, work: Document) -> tuple[str, ...]:
    if document.kind == "work":
        return ("clarify",)
    definition = {
        "product": "definition",
        "feature": "definition",
        "capability": "definition",
        "issue": "definition",
        "change": "definition",
        "improvement": "definition",
        "experience": "experience",
        "design": "design",
        "decision": "decision",
        "plan": "plan",
        "task": "tasks",
        "verify": "verification",
        "memory": "memory",
    }.get(document.kind)
    if document.kind == "task":
        return ("tasks", "development")
    return (definition,) if definition else ()


def bind_workflow_artifacts(work: Document, documents: Iterable[Document]) -> None:
    stages = {stage["stage"]: stage for stage in work.metadata["workflow"]}
    for stage in stages.values():
        stage["artifacts"] = []
    for document in documents:
        if document.id != work.id and document.metadata.get("work") != work.id:
            continue
        for stage_name in stages_for_document(document, work):
            if stage_name in stages and document.id not in stages[stage_name]["artifacts"]:
                stages[stage_name]["artifacts"].append(document.id)
    for stage in stages.values():
        stage["artifacts"].sort()


def render_flow(work: "Document", documents: dict[str, "Document"]) -> str:
    """把控制面渲染成人能读的视图。真源是各文档自己的状态，这里只负责显示。"""
    workflow = work.metadata.get("workflow") or []
    # 只留表格：流程图对一条线性阶段链没有任何表格之外的信息，却多出一处需要同步的地方。
    lines = [
        "<!-- 本节由 `scripts/work` 生成，请勿手工编辑；改动请运行 refresh。"
        "交互式视图见 `scripts/work board`。 -->",
        "",
        "| 阶段 | 状态 | 必需性 | 依据文档 | 说明 |",
        "|---|---|---|---|---|",
    ]
    for stage in workflow:
        status = stage["status"]
        cell = f"{STAGE_SYMBOLS.get(status, '·')} {STAGE_STATUS_LABELS.get(status, status)}"
        if stage.get("status_source") == "manual":
            cell += "（手动）"
        artifacts = []
        for artifact_id in stage.get("artifacts", []):
            target = documents.get(artifact_id)
            artifacts.append(
                f"{artifact_id} `{target.metadata['status']}`" if target else f"{artifact_id} `缺失`"
            )
        lines.append(
            f"| {stage['label']} | {cell} "
            f"| {'必需' if stage['requirement'] == 'required' else '可选'} "
            f"| {'、'.join(artifacts) or '—'} "
            f"| {STAGE_DESCRIPTIONS.get(stage['stage'], '')} |"
        )
    return "\n".join(lines)


def apply_flow_section(work: "Document", documents: dict[str, "Document"]) -> None:
    rendered = render_flow(work, documents)
    pattern = re.compile(rf"(?ms)^## {FLOW_SECTION}\n+.*?(?=^## |\Z)")
    block = f"## {FLOW_SECTION}\n\n{rendered}\n\n"
    work.body = (
        pattern.sub(lambda _: block, work.body, count=1)
        if pattern.search(work.body)
        else work.body.rstrip() + "\n\n" + block
    )


def synchronize_workflow(work: Document, documents: dict[str, Document]) -> None:
    """根据文档、任务、验证和 WORK 状态刷新阶段进度。"""

    workflow = work.metadata["workflow"]
    stage_by_name = {stage["stage"]: stage for stage in workflow}

    def artifacts(stage: dict[str, Any], kind: str | None = None) -> list[Document]:
        values = [documents[value] for value in stage["artifacts"] if value in documents]
        return [document for document in values if kind is None or document.kind == kind]

    raw_statuses: dict[str, str] = {}
    for stage in workflow:
        name = stage["stage"]
        stage_documents = artifacts(stage)
        if name == "clarify":
            stage["status_source"] = "derived"
            raw_statuses[name] = "blocked" if work.metadata.get("blocking_items") else "done"
            continue
        if name == "tasks":
            stage["status_source"] = "derived"
            tasks = [document for document in stage_documents if document.kind == "task" and document.metadata["status"] != "cancelled"]
            if not tasks:
                raw_statuses[name] = "skipped" if stage["requirement"] == "optional" else "pending"
            elif any(task.metadata["status"] == "blocked" for task in tasks):
                raw_statuses[name] = "blocked"
            elif all(task.metadata["status"] in {"ready", "doing", "done", "verified"} for task in tasks):
                raw_statuses[name] = "done"
            else:
                raw_statuses[name] = "ready"
            continue
        if name == "development":
            stage["status_source"] = "derived"
            tasks = [document for document in stage_documents if document.kind == "task" and document.metadata["status"] != "cancelled"]
            if not tasks:
                raw_statuses[name] = "pending"
            elif any(task.metadata["status"] == "blocked" for task in tasks):
                raw_statuses[name] = "blocked"
            elif all(task.metadata["status"] in {"done", "verified"} for task in tasks):
                raw_statuses[name] = "done"
            elif any(task.metadata["status"] == "doing" for task in tasks):
                raw_statuses[name] = "doing"
            elif all(task.metadata["status"] in {"ready", "doing", "done", "verified"} for task in tasks):
                raw_statuses[name] = "ready"
            else:
                raw_statuses[name] = "pending"
            continue
        if name == "review":
            verification = stage_by_name.get("verification")
            verification_documents = artifacts(verification) if verification else []
            if verification_documents and all(
                document.metadata.get("status") == "approved" and document.metadata.get("result") == "pass"
                for document in verification_documents
            ):
                stage["status_source"] = "derived"
                raw_statuses[name] = "done"
            elif stage["status_source"] == "manual":
                raw_statuses[name] = stage["status"]
            elif raw_statuses.get("development") == "done":
                raw_statuses[name] = "ready"
            else:
                raw_statuses[name] = "pending"
            continue
        if name == "verification":
            stage["status_source"] = "derived"
            verifies = [document for document in stage_documents if document.kind == "verify"]
            if not verifies:
                raw_statuses[name] = "skipped" if stage["requirement"] == "optional" else "pending"
            elif any(
                document.metadata.get("status") == "approved"
                and document.metadata.get("result") in {"fail", "partial"}
                for document in verifies
            ):
                raw_statuses[name] = "blocked"
            elif all(
                document.metadata.get("status") == "approved" and document.metadata.get("result") == "pass"
                for document in verifies
            ):
                raw_statuses[name] = "done"
            elif any(document.metadata.get("status") == "review" for document in verifies):
                raw_statuses[name] = "doing"
            else:
                raw_statuses[name] = "ready"
            continue

        if not stage_documents:
            stage["status_source"] = "derived"
            raw_statuses[name] = "skipped" if stage["requirement"] == "optional" else "pending"
            continue
        statuses = [document.metadata["status"] for document in stage_documents]
        stage["status_source"] = "derived"
        if any(status == "blocked" for status in statuses):
            raw_statuses[name] = "blocked"
        elif all(status in SATISFIED_DEPENDENCY_STATUSES for status in statuses):
            raw_statuses[name] = "done"
        elif any(status in {"review", "doing"} for status in statuses):
            raw_statuses[name] = "doing"
        else:
            raw_statuses[name] = "ready"

    if work.metadata.get("blocking_items"):
        first_required = next(
            (stage for stage in workflow if stage["requirement"] == "required"),
            None,
        )
        if first_required:
            raw_statuses[first_required["stage"]] = "blocked"
            first_required["status_source"] = "derived"

    prior_required_done = True
    for stage in workflow:
        status = raw_statuses[stage["stage"]]
        invalid_manual_progress = (
            stage["status_source"] == "manual" and status in {"ready", "doing", "done"}
        )
        if not prior_required_done and (status == "ready" or invalid_manual_progress):
            status = "pending"
            stage["status_source"] = "derived"
        # 检查项的牙齿：声明了检查却没有结论，阶段就停在进行中。
        # 用「拦住推进」而不是「校验报错」——报错会让签闸这类正常动作直接失败，
        # 而门禁的本意是让工作停下来等结论，不是让人无法操作。
        # 历史数据是 unrecorded 不是 pending，因此这条不追溯既往。
        if status == "done" and any(
            check_result(check) == "pending" for check in stage.get("checks") or []
        ):
            status = "doing"
        stage["status"] = status
        if stage["requirement"] == "required" and status != "done":
            prior_required_done = False

    # 视图跟着真源走：每次控制面刷新都重渲染，人永远不需要手工同步这一节。
    apply_flow_section(work, documents)


def new_metadata(
    document_id: str,
    kind: str,
    title: str,
    work_id: str | None,
    owners: list[str],
    **extra: Any,
) -> dict[str, Any]:
    status = "todo" if kind in {"work", "task"} else "draft"
    metadata: dict[str, Any] = {
        "id": document_id,
        "type": kind,
        "title": title,
        "status": status,
        "work": work_id,
        "owners": owners,
        "depends_on": [],
        "related": [],
        "implements": [],
        "verifies": [],
        "tags": [],
        "created_at": today(),
        "updated_at": today(),
    }
    metadata.update(extra)
    return metadata


def generate_work_documents(
    root: Path,
    index: dict[str, Any],
    work: Document,
    required_types: list[str],
) -> list[Document]:
    created: list[Document] = []
    by_type: dict[str, Document] = {}
    definition_types = {"feature", "capability", "issue", "change", "improvement"}
    for kind in required_types:
        document_id = allocate_id(index, kind)
        title = work.metadata["title"]
        metadata = new_metadata(document_id, kind, title, work.id, work.metadata["owners"])
        upstream: list[str] = []
        definition = next((item for item in created if item.kind in definition_types), None)
        if kind == "experience" and definition:
            upstream = [definition.id]
        elif kind == "design":
            upstream = [item.id for item in created if item.kind in definition_types | {"experience"}]
        elif kind == "decision" and by_type.get("design"):
            upstream = [by_type["design"].id]
        elif kind == "plan":
            upstream = [
                item.id
                for item in created
                if item.kind in definition_types | {"experience", "design", "decision"}
            ]
        elif kind == "task":
            upstream = [
                item.id
                for item in created
                if item.kind in definition_types | {"design", "decision", "plan"}
            ]
            metadata.update(
                {
                    "read_paths": ["按技术方案补充"],
                    "write_paths": ["按开发计划补充"],
                    "forbidden_paths": ["超出当前工作项的区域"],
                    "implements": [definition.id] if definition else [],
                }
            )
        elif kind == "verify":
            task = by_type.get("task")
            upstream = [task.id] if task else []
            metadata.update(
                {
                    "result": "pending",
                    "verifies": [item.id for item in created if item.kind in definition_types | {"task"}],
                }
            )
        elif kind == "memory" and by_type.get("verify"):
            upstream = [by_type["verify"].id]
        metadata["depends_on"] = upstream
        document = Document(
            path=document_path(work.path.parent, kind, document_id),
            metadata=metadata,
            body=template_body(root, kind, document_id, title),
        )
        created.append(document)
        by_type[kind] = document
    return created


def reference_target(value: str) -> str | None:
    match = REF_PATTERN.fullmatch(value)
    return match.group(1) if match else None


def validate_shape(document: Document, root: Path) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    metadata = document.metadata
    prefix = str(document.path.relative_to(root))
    missing = COMMON_REQUIRED - set(metadata)
    unknown = set(metadata) - COMMON_FIELDS
    if missing:
        errors.append(f"{prefix}: 缺少字段：{', '.join(sorted(missing))}")
    if unknown:
        errors.append(f"{prefix}: 未知字段：{', '.join(sorted(unknown))}")
    if missing:
        return errors, warnings
    kind = metadata["type"]
    if kind not in DOCUMENT_TYPES:
        errors.append(f"{prefix}: type 无效：{kind}")
        return errors, warnings
    match = ID_PATTERN.fullmatch(str(metadata["id"]))
    expected_prefix, _ = TYPE_CONFIG[kind]
    if not match or match.group(1) != expected_prefix:
        errors.append(f"{prefix}: id 必须匹配 {expected_prefix}-001 格式")
    work_directory = document.path.parent
    work_directory_match = WORK_DIRECTORY_PATTERN.fullmatch(work_directory.name)
    if work_directory.parent != root / "development" / "works" or work_directory_match is None:
        errors.append(f"{prefix}: 受管理文档必须位于 development/works/WORK-001/ 下")
    elif kind == "work" and work_directory_match.group(1) != metadata["id"]:
        errors.append(f"{prefix}: 工作项目录 ID 必须与 {metadata['id']} 一致")
    expected_filename = document_filename(kind, str(metadata["id"]))
    if document.path.name != expected_filename:
        errors.append(f"{prefix}: {kind} 文档文件名必须是 {expected_filename}")
    valid_statuses = WORK_STATUSES if kind == "work" else TASK_STATUSES if kind == "task" else DOCUMENT_STATUSES
    if metadata["status"] not in valid_statuses:
        errors.append(f"{prefix}: {kind} 状态无效：{metadata['status']}")
    if kind == "work":
        if metadata["work"] is not None:
            errors.append(f"{prefix}: 工作项的 work 必须为 null")
        for field, allowed in (("risk", set(RISKS)), ("impact", IMPACTS)):
            if metadata.get(field) not in allowed:
                errors.append(f"{prefix}: {field} 无效：{metadata.get(field)}")
        if metadata.get("work_type") not in WORK_TYPES:
            errors.append(f"{prefix}: work_type 无效：{metadata.get('work_type')}")
        for field in (
            "concerns",
            "workflow",
            "required_documents",
            "required_checks",
            "blocking_items",
        ):
            if not isinstance(metadata.get(field), list):
                errors.append(f"{prefix}: {field} 必须是列表")
        invalid_concerns = set(metadata.get("concerns", [])) - CONCERNS
        if invalid_concerns:
            errors.append(f"{prefix}: concerns 无效：{', '.join(sorted(invalid_concerns))}")
        outcome = metadata.get("outcome")
        if outcome is not None:
            if not isinstance(outcome, dict) or set(outcome) - {"state", "by", "reason"}:
                errors.append(f"{prefix}: outcome 只允许 state / by / reason 三个字段")
            elif outcome.get("state") not in OUTCOME_STATES:
                errors.append(f"{prefix}: outcome.state 无效：{outcome.get('state')}")
            elif not str(outcome.get("reason") or "").strip():
                errors.append(f"{prefix}: outcome 必须写明理由——它是唯一解释「为什么不算数了」的地方")
            elif metadata.get("status") not in OUTCOME_ALLOWED_WORK_STATUSES:
                errors.append(
                    f"{prefix}: {metadata.get('status')} 的工作没有产出，谈不上结论被推翻；"
                    f"这种情况用 cancelled"
                )
            elif outcome["state"] == "superseded" and not outcome.get("by"):
                errors.append(f"{prefix}: superseded 必须用 by 指出接替它的工作")
            elif outcome.get("by") == metadata.get("id"):
                errors.append(f"{prefix}: outcome.by 不能指向自己")
        gates = metadata.get("gates")
        if not isinstance(gates, dict) or set(gates) != set(GATE_NAMES):
            errors.append(f"{prefix}: gates 必须同时包含 {', '.join(GATE_NAMES)}")
        else:
            for name, value in gates.items():
                if value not in GATE_STATUSES:
                    errors.append(f"{prefix}: gates.{name} 无效：{value}")
        seen_stages: set[str] = set()
        for stage in metadata.get("workflow", []):
            required_fields = {
                "stage",
                "label",
                "requirement",
                "status",
                "status_source",
                "artifacts",
                "checks",
                "source",
                "reason",
            }
            if not isinstance(stage, dict) or set(stage) != required_fields:
                errors.append(f"{prefix}: workflow 阶段字段必须是 {', '.join(sorted(required_fields))}")
                break
            if not isinstance(stage["stage"], str) or not stage["stage"] or stage["stage"] in seen_stages:
                errors.append(f"{prefix}: workflow stage 必须是非空且唯一的字符串")
                break
            seen_stages.add(stage["stage"])
            if not isinstance(stage["label"], str) or not stage["label"]:
                errors.append(f"{prefix}: workflow.label 必须是非空字符串")
            if stage["requirement"] not in STAGE_REQUIREMENTS:
                errors.append(f"{prefix}: workflow.requirement 无效：{stage['requirement']}")
            if stage["status"] not in STAGE_PROGRESS:
                errors.append(f"{prefix}: workflow.status 无效：{stage['status']}")
            if stage["status_source"] not in {"derived", "manual"}:
                errors.append(f"{prefix}: workflow.status_source 无效：{stage['status_source']}")
            if not isinstance(stage["checks"], list) or not all(
                isinstance(check, dict)
                and set(check) == {"name", "result", "note"}
                and isinstance(check["name"], str)
                and check["name"]
                and check["result"] in CHECK_RESULTS
                and isinstance(check["note"], str)
                for check in stage["checks"]
            ):
                errors.append(
                    f"{prefix}: workflow.checks 每项必须是 "
                    f"{{name, result, note}}，result 取值 {', '.join(sorted(CHECK_RESULTS))}"
                )
            for field in ("artifacts",):
                if not isinstance(stage[field], list) or not all(
                    isinstance(item, str) and item for item in stage[field]
                ):
                    errors.append(f"{prefix}: workflow.{field} 必须是字符串列表")
                elif len(stage[field]) != len(set(stage[field])):
                    errors.append(f"{prefix}: workflow.{field} 不允许重复")
            for field in ("source", "reason"):
                if not isinstance(stage[field], str) or not stage[field]:
                    errors.append(f"{prefix}: workflow.{field} 必须是非空字符串")
    else:
        if not isinstance(metadata["work"], str) or not metadata["work"].startswith("WORK-"):
            errors.append(f"{prefix}: 非工作项文档必须关联 WORK ID")
    if not isinstance(metadata["owners"], list) or not all(
        isinstance(owner, str) and owner for owner in metadata["owners"]
    ):
        errors.append(f"{prefix}: owners 必须是非空字符串列表")
    for field in ("depends_on", "related", "implements", "verifies", "tags"):
        if field in metadata and (
            not isinstance(metadata[field], list)
            or not all(isinstance(item, str) and item for item in metadata[field])
        ):
            errors.append(f"{prefix}: {field} 必须是字符串列表")
    for field in ("created_at", "updated_at"):
        if not isinstance(metadata[field], str) or not DATE_PATTERN.fullmatch(metadata[field]):
            errors.append(f"{prefix}: {field} 必须是 YYYY-MM-DD")
    if isinstance(metadata.get("created_at"), str) and isinstance(metadata.get("updated_at"), str):
        if metadata["updated_at"] < metadata["created_at"]:
            errors.append(f"{prefix}: updated_at 不能早于 created_at")
    for title in REQUIRED_SECTIONS[kind]:
        if section(document.body, title) is None:
            errors.append(f"{prefix}: 缺少正文段落 `## {title}`")
    if kind in DEFINITION_KINDS:
        expected = REQUIRED_SECTIONS[kind][0]
        headings = re.findall(r"(?m)^## (.+?)\s*$", document.body)
        if headings and headings[0] != expected:
            errors.append(
                f"{prefix}: 定义层文档的第一节必须是 `## {expected}`（面向非技术读者的入口），"
                f"当前是 `## {headings[0]}`"
            )
    if metadata["status"] in FINAL_DOCUMENT_STATUSES | {"ready", "doing", "done", "verified", "implemented"}:
        markers = [marker for marker in PLACEHOLDER_MARKERS if marker in document.body]
        if markers:
            errors.append(f"{prefix}: 稳定状态文档仍含占位内容：{', '.join(markers)}")
    if kind == "task" and metadata["status"] in {"ready", "doing", "done", "verified"}:
        for field in ("read_paths", "write_paths", "forbidden_paths"):
            values = metadata.get(field)
            if not isinstance(values, list) or not values:
                errors.append(f"{prefix}: {metadata['status']} 任务必须声明 {field}")
        if metadata["status"] in {"done", "verified"}:
            total, completed = checkbox_state(document.body, "完成标准")
            if total == 0 or completed != total:
                errors.append(
                    f"{prefix}: {metadata['status']} 任务的完成标准必须全部勾选（{completed}/{total}）"
                )
    if kind == "verify" and metadata.get("result") not in {"pending", "pass", "fail", "partial"}:
        errors.append(f"{prefix}: verify.result 必须是 pending/pass/fail/partial")
    return errors, warnings


def validate_documents(
    documents: dict[str, Document], root: Path, index: dict[str, Any]
) -> tuple[list[str], list[str]]:
    errors = validate_repository_layout(root)
    warnings: list[str] = []
    for document in documents.values():
        document_errors, document_warnings = validate_shape(document, root)
        errors.extend(document_errors)
        warnings.extend(document_warnings)

    works = {doc_id: document for doc_id, document in documents.items() if document.kind == "work"}
    for document in documents.values():
        prefix = str(document.path.relative_to(root))
        if document.kind != "work" and document.metadata.get("work") not in works:
            errors.append(f"{prefix}: work 引用了不存在的 {document.metadata.get('work')}")
        elif document.kind != "work" and document.path.parent != works[document.metadata["work"]].path.parent:
            errors.append(
                f"{prefix}: 文档必须与所属 {document.metadata['work']} 位于同一工作项目录"
            )
        for field in REFERENCE_FIELDS:
            values = document.metadata.get(field, [])
            if not isinstance(values, list):
                continue
            for value in values:
                target = reference_target(value) if isinstance(value, str) else None
                if target is None:
                    errors.append(f"{prefix}: {field} 引用格式无效：{value}")
                elif target not in documents:
                    errors.append(f"{prefix}: {field} 引用了不存在的 {target}")
                elif "#" in value and value.split("#", 1)[1] not in documents[target].body:
                    errors.append(f"{prefix}: {field} 引用的局部编号不存在：{value}")
        supersedes = document.metadata.get("supersedes")
        if supersedes is not None and supersedes not in documents:
            errors.append(f"{prefix}: supersedes 引用了不存在的 {supersedes}")
        if document.kind not in {"work", "task"} and is_settled(document):
            unsatisfied = []
            for value in document.metadata.get("depends_on", []):
                target = reference_target(value)
                if target in documents and documents[target].metadata.get("status") not in SATISFIED_DEPENDENCY_STATUSES:
                    unsatisfied.append(target)
            if unsatisfied:
                errors.append(f"{prefix}: approved 文档依赖尚未完成：{', '.join(unsatisfied)}")

    visiting: list[str] = []
    visited: set[str] = set()

    def visit(document_id: str) -> None:
        if document_id in visited:
            return
        if document_id in visiting:
            cycle = visiting[visiting.index(document_id) :] + [document_id]
            errors.append(f"文档依赖形成环：{' -> '.join(cycle)}")
            return
        visiting.append(document_id)
        for value in documents[document_id].metadata.get("depends_on", []):
            target = reference_target(value) if isinstance(value, str) else None
            if target in documents:
                visit(target)
        visiting.pop()
        visited.add(document_id)

    for document_id in documents:
        visit(document_id)

    by_work: dict[str, list[Document]] = defaultdict(list)
    for document in documents.values():
        if isinstance(document.metadata.get("work"), str):
            by_work[document.metadata["work"]].append(document)
    for work_id, work in works.items():
        prefix = str(work.path.relative_to(root))
        expected_flow = select_workflow({**work.metadata, "type": work.metadata["work_type"]})
        for field in ("required_documents", "required_checks"):
            if work.metadata.get(field) != expected_flow[field]:
                errors.append(f"{prefix}: {field} 必须由 WORK Type 与风险增量规则生成")
        actual_workflow = work.metadata.get("workflow", [])
        expected_workflow = expected_flow["workflow"]
        # 只比较检查项的名字：结论是执行过程中的事实，不属于「流程该长什么样」。
        configuration_fields = ("stage", "label", "requirement", "source", "reason")

        def configuration(stage: dict[str, Any]) -> dict[str, Any]:
            shape = {field: stage.get(field) for field in configuration_fields}
            shape["checks"] = [check_name(check) for check in stage.get("checks") or []]
            return shape

        actual_configuration = [
            configuration(stage) for stage in actual_workflow if isinstance(stage, dict)
        ]
        expected_configuration = [configuration(stage) for stage in expected_workflow]
        if actual_configuration != expected_configuration:
            errors.append(f"{prefix}: workflow 阶段顺序或配置与 WORK Type / 风险规则不一致")

        bound_artifacts: set[str] = set()
        for stage in actual_workflow:
            if not isinstance(stage, dict) or not isinstance(stage.get("artifacts"), list):
                continue
            for artifact_id in stage["artifacts"]:
                if artifact_id not in documents:
                    errors.append(f"{prefix}: workflow 引用了不存在的 artifact：{artifact_id}")
                    continue
                artifact = documents[artifact_id]
                if artifact.id != work.id and artifact.metadata.get("work") != work.id:
                    errors.append(f"{prefix}: workflow artifact {artifact_id} 不属于 {work.id}")
                bound_artifacts.add(artifact_id)
        for document in by_work[work_id]:
            if document.kind in set(work.metadata.get("required_documents", [])) and document.id not in bound_artifacts:
                errors.append(f"{prefix}: 必需文档 {document.id} 没有关联到 workflow stage")

        synchronized_metadata = json.loads(json.dumps(work.metadata, ensure_ascii=False))
        synchronized = Document(path=work.path, metadata=synchronized_metadata, body=work.body)
        synchronize_workflow(synchronized, documents)
        synchronized_statuses = {
            stage["stage"]: stage["status"] for stage in synchronized.metadata["workflow"]
        }
        actual_statuses = {
            stage.get("stage"): stage.get("status")
            for stage in actual_workflow
            if isinstance(stage, dict)
        }
        if actual_statuses != synchronized_statuses:
            errors.append(f"{prefix}: workflow 阶段状态未与文档、任务和 WORK 事实同步")

        expected = set(work.metadata.get("required_documents", []))
        actual = {document.kind for document in by_work[work_id]}
        missing = expected - actual
        if missing:
            message = f"{prefix}: 缺少流程要求文档：{', '.join(sorted(missing))}"
            if work.metadata.get("status") in {"ready", "doing", "implemented", "verified"}:
                errors.append(message)
            else:
                warnings.append(message)
        if work.metadata.get("status") in {"ready", "doing", "implemented", "verified"}:
            if work.metadata.get("blocking_items"):
                errors.append(f"{prefix}: 当前状态不允许存在 blocking_items")
        # 死锁探测：事实都齐了却推不动，说明存在任何命令都出不去的状态。
        # human_confirmations 就是这样把 4 个已完成的工作按在 todo 上的——它由规则生成、
        # 阻塞状态推导、又必须等于规则重新生成的值，于是没有任何操作能满足它。
        if (
            work.metadata.get("status") not in {"verified", "cancelled"}
            and not work.metadata.get("blocking_items")
            and all(gate_passed(work, gate) for gate in GATE_NAMES)
            and all(
                stage["status"] in {"done", "skipped"}
                for stage in work.metadata.get("workflow", [])
                if stage["requirement"] == "required"
            )
        ):
            warnings.append(
                f"{prefix}: 全部必需阶段已完成且两道闸都已签署，状态却是 "
                f"{work.metadata.get('status')}——存在推不动的状态，请检查推导规则"
            )
        outcome = work_outcome(work)
        if outcome is not None:
            target = outcome.get("by")
            if target is not None:
                if target not in documents or documents[target].kind != "work":
                    errors.append(f"{prefix}: outcome.by 引用了不存在的工作项：{target}")
                else:
                    # 成环意味着两个工作互相声明被对方取代，读者无从判断哪个有效。
                    seen, cursor = {work_id}, target
                    while cursor in works:
                        following = (work_outcome(works[cursor]) or {}).get("by")
                        if following is None:
                            break
                        if following in seen:
                            errors.append(f"{prefix}: outcome.by 形成环：{work_id} → … → {following}")
                            break
                        seen.add(cursor)
                        cursor = following
            if outcome.get("state") == "invalidated" and not any(
                d.kind == "memory" for d in by_work[work_id]
            ):
                errors.append(
                    f"{prefix}: 结论被证伪的工作必须留下 MEMORY——"
                    f"「当时为什么判断错」是这类工作唯一的产出，不留就等于白错一次"
                )
        for gate in GATE_NAMES:
            covered = gate_covered_documents(work_id, documents, gate)
            passed = gate_passed(work, gate)
            premature = [
                document.id
                for document in covered
                if document.metadata.get("status") == "approved" and not passed
            ]
            if premature:
                errors.append(
                    f"{prefix}: {GATE_LABELS[gate]}尚未通过，以下文档不应是 approved："
                    + ", ".join(premature)
                )
            regressed = [
                document.id
                for document in covered
                if passed and document.metadata.get("status") in {"draft", "review"}
            ]
            if regressed:
                errors.append(
                    f"{prefix}: {GATE_LABELS[gate]}已通过，以下文档不应退回未定稿："
                    + ", ".join(regressed)
                )
        tasks = [document for document in by_work[work_id] if document.kind == "task"]
        verifies = [document for document in by_work[work_id] if document.kind == "verify"]
        if work.metadata.get("status") in {"ready", "doing", "implemented", "verified"}:
            prep_types = expected - {"task", "verify", "memory"}
            unfinished_prep = [
                document.id
                for document in by_work[work_id]
                if document.kind in prep_types and not is_settled(document)
            ]
            if unfinished_prep:
                errors.append(f"{prefix}: ready 之后仍有未确认的上游文档：{', '.join(unfinished_prep)}")
            if not tasks:
                errors.append(f"{prefix}: ready 之后必须存在 TASK")
        if work.metadata.get("status") in {"implemented", "verified"}:
            unfinished = [task.id for task in tasks if task.metadata.get("status") not in {"done", "verified", "cancelled"}]
            if unfinished:
                errors.append(f"{prefix}: implemented 之后仍有未完成任务：{', '.join(unfinished)}")
        if work.metadata.get("status") in {"verified"}:
            passing = [doc for doc in verifies if doc.metadata.get("status") == "approved" and doc.metadata.get("result") == "pass"]
            if not passing:
                errors.append(f"{prefix}: verified 之后必须存在 result=pass 的 approved 验证结果")
        stage_boundary = {
            "ready": "tasks",
            "doing": "tasks",
            "implemented": "development",
            "verified": "verification",
        }.get(str(work.metadata.get("status")))
        stages_to_check: list[dict[str, Any]] = []
        if stage_boundary:
            for stage in actual_workflow:
                stages_to_check.append(stage)
                if stage.get("stage") == stage_boundary:
                    break
        unfinished_stages = [
            stage.get("label", stage.get("stage"))
            for stage in stages_to_check
            if stage.get("requirement") == "required" and stage.get("status") != "done"
        ]
        if unfinished_stages:
            errors.append(
                f"{prefix}: {work.metadata.get('status')} 状态之前仍有未完成流程阶段："
                + ", ".join(str(value) for value in unfinished_stages)
            )

    for document in documents.values():
        if document.kind != "task" or document.metadata.get("status") not in {"ready", "doing", "done", "verified"}:
            continue
        unsatisfied = []
        for value in document.metadata.get("depends_on", []):
            target = reference_target(value)
            if target in documents and documents[target].metadata.get("status") not in SATISFIED_DEPENDENCY_STATUSES:
                unsatisfied.append(target)
        if unsatisfied:
            errors.append(f"{document.path.relative_to(root)}: 活跃任务依赖尚未完成：{', '.join(unsatisfied)}")
        if document.metadata.get("status") == "verified":
            evidence = [
                candidate
                for candidate in documents.values()
                if candidate.kind == "verify"
                and candidate.metadata.get("work") == document.metadata.get("work")
                and candidate.metadata.get("status") == "approved"
                and candidate.metadata.get("result") == "pass"
                and document.id in candidate.metadata.get("verifies", [])
            ]
            if not evidence:
                errors.append(
                    f"{document.path.relative_to(root)}: verified TASK 必须有明确引用它的 approved/pass VERIFY"
                )

    next_ids = index.get("next_ids", {})
    for kind in DOCUMENT_TYPES:
        value = next_ids.get(kind)
        if not isinstance(value, int) or value < 1:
            errors.append(f"development/index.json: 缺少有效的 {kind} 计数器")
            continue
        prefix, _ = TYPE_CONFIG[kind]
        used = [int(match.group(2)) for doc_id in documents if (match := ID_PATTERN.fullmatch(doc_id)) and match.group(1) == prefix]
        if used and value <= max(used):
            errors.append(f"development/index.json: {kind} 的 next id 必须大于 {max(used)}")
    return errors, warnings


def checked_documents(root: Path) -> tuple[dict[str, Document], dict[str, Any]]:
    index = load_index(root)
    documents = load_documents(root)
    errors, _ = validate_documents(documents, root, index)
    if errors:
        raise WorkError("开发文档系统校验失败：\n- " + "\n- ".join(errors))
    return documents, index


def require_document(documents: dict[str, Document], document_id: str) -> Document:
    try:
        return documents[document_id]
    except KeyError as error:
        raise WorkError(f"找不到文档 {document_id}") from error


def flow_view_drift(documents: dict[str, "Document"], root: Path) -> list[str]:
    """视图过期最危险的地方在于：它看起来和最新的一模一样。

    只在 check 里报，不放进 validate_documents——否则 refresh 会被它自己要修的错误挡住。
    所有会改动状态的命令都会重渲染并写回，正常路径不会产生漂移。
    """
    problems: list[str] = []
    for work in documents.values():
        if work.kind != "work":
            continue
        if section(work.body, FLOW_SECTION) != render_flow(work, documents).strip():
            problems.append(
                f"{work.path.relative_to(root)}: `## {FLOW_SECTION}` 与实际控制面不一致"
                f"（该节由工具生成）。请运行：scripts/work refresh {work.id}"
            )
    return problems


def command_check(args: argparse.Namespace) -> None:
    schema_path = args.root / "development" / "schema" / "document.schema.json"
    try:
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise WorkError(f"缺少 schema：{schema_path}") from error
    except json.JSONDecodeError as error:
        raise WorkError(f"{schema_path}: JSON 解析失败：{error}") from error
    if set(schema.get("required", [])) != COMMON_REQUIRED:
        raise WorkError(f"{schema_path}: required 必须与工具的通用必填字段一致")
    if set(schema.get("properties", {})) != COMMON_FIELDS:
        raise WorkError(f"{schema_path}: properties 必须与工具支持的元数据字段一致")
    for kind in DOCUMENT_TYPES:
        template_path = args.root / "development" / "templates" / f"{kind}.md"
        if not template_path.is_file():
            raise WorkError(f"缺少模板：{template_path}")
        template = template_path.read_text(encoding="utf-8")
        for title in REQUIRED_SECTIONS[kind]:
            if f"## {title}\n" not in template:
                raise WorkError(f"{template_path}: 缺少 `## {title}`")
    index = load_index(args.root)
    documents = load_documents(args.root)
    if not any(document.kind == "work" for document in documents.values()):
        raise WorkError("development/ 至少需要保留一个工作项")
    errors, warnings = validate_documents(documents, args.root, index)
    errors.extend(validate_works_index(args.root, documents))
    errors.extend(flow_view_drift(documents, args.root))
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        raise WorkError(f"发现 {len(errors)} 个开发文档错误")
    print(f"✓ {len(documents)} 份开发文档通过校验（{len(warnings)} 个进行中提示）")


def command_new(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    risk = effective_risk(
        args.risk,
        args.concern,
        not args.not_reversible,
        args.data_change,
        args.public_api_change,
        args.security_sensitive,
    )
    work_id = allocate_id(index, "work")
    metadata = new_metadata(work_id, "work", args.title, None, args.owner)
    metadata.update(
        {
            "work_type": args.work_type,
            "risk": risk,
            "impact": args.impact,
            "concerns": list(dict.fromkeys(args.concern)),
            "blocking_items": list(dict.fromkeys(args.blocking)),
            "reversible": not args.not_reversible,
            "data_change": args.data_change,
            "public_api_change": args.public_api_change,
            "security_sensitive": args.security_sensitive,
            "user_visible": args.user_visible or args.work_type == "product",
            "gates": {name: "pending" for name in GATE_NAMES},
        }
    )
    workflow_metadata = select_workflow({**metadata, "type": args.work_type})
    metadata.update({key: value for key, value in workflow_metadata.items() if key != "fast"})
    work_directory = work_directory_path(args.root, work_id)
    work = Document(
        path=document_path(work_directory, "work", work_id),
        metadata=metadata,
        body=template_body(args.root, "work", work_id, args.title),
    )
    generated = generate_work_documents(
        args.root, index, work, workflow_metadata["required_documents"]
    )
    work.metadata["related"] = [document.id for document in generated]
    prospective = dict(documents)
    prospective[work.id] = work
    prospective.update({document.id: document for document in generated})
    bind_workflow_artifacts(work, [work, *generated])
    synchronize_workflow(work, prospective)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("无法创建工作项：\n- " + "\n- ".join(errors))
    write_document(work)
    for document in generated:
        write_document(document)
    write_index(args.root, index)
    if risk != args.risk:
        print(f"注意：风险已按影响规则从 {args.risk} 自动升级为 {risk}")
    mode = "快速流程" if workflow_metadata["fast"] else "标准/完整流程"
    print(f"✓ 已创建 {work_id}（{mode}）")
    print("已生成：" + ", ".join(document.id for document in generated))
    print(
        f"下一步：补全 {generated[0].id} 和所需上游文档，提交人工审核；"
        f"获得明确执行授权前不要开始实施。可用 `scripts/work flow {work_id}` 查看推进条件。"
    )


def command_new_doc(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    document_id = allocate_id(index, args.type)
    metadata = new_metadata(document_id, args.type, args.title, work.id, args.owner or work.metadata["owners"])
    metadata["depends_on"] = args.depends_on
    metadata["related"] = args.related
    metadata["implements"] = args.implements
    metadata["verifies"] = args.verifies
    if args.type == "task":
        metadata.update(
            {
                "read_paths": args.read_path,
                "write_paths": args.write_path,
                "forbidden_paths": args.forbidden_path,
            }
        )
    if args.type == "verify":
        metadata["result"] = "pending"
    document = Document(
        path=document_path(work.path.parent, args.type, document_id),
        metadata=metadata,
        body=template_body(args.root, args.type, document_id, args.title),
    )
    prospective = dict(documents)
    prospective[document.id] = document
    work.metadata["related"] = list(dict.fromkeys(work.metadata.get("related", []) + [document.id]))
    prospective[work.id] = work
    bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
    synchronize_workflow(work, prospective)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("无法创建文档：\n- " + "\n- ".join(errors))
    write_document(document)
    work.metadata["updated_at"] = today()
    write_document(work)
    write_index(args.root, index)
    print(f"✓ 已创建 {document.path.relative_to(args.root)}")


def work_type_of(document: Document, documents: dict[str, Document]) -> str:
    if document.kind == "work":
        return str(document.metadata.get("work_type", "-"))
    work = documents.get(str(document.metadata.get("work")))
    return str(work.metadata.get("work_type", "-")) if work else "-"


def command_list(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    rows = []
    for document in documents.values():
        if args.type and document.kind != args.type:
            continue
        if args.status and document.metadata.get("status") != args.status:
            continue
        if args.work and document.id != args.work and document.metadata.get("work") != args.work:
            continue
        if args.needs_human and not (
            document.kind == "work" and pending_gates(document, documents)
        ):
            continue
        rows.append(
            (
                document.id,
                document.kind,
                str(document.metadata.get("status")),
                work_type_of(document, documents),
                ",".join(document.metadata.get("owners", [])),
                document.metadata.get("title"),
            )
        )
    print("ID\t文档类型\t状态\t工作类型\t负责人\t标题")
    for row in sorted(rows):
        print("\t".join(row))


def command_show(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    document = require_document(documents, args.document_id)
    print(document.path.relative_to(args.root))
    print()
    print(render_document(document), end="")


def command_overview(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    works = sorted(
        (document for document in documents.values() if document.kind == "work"),
        key=lambda document: document.id,
    )
    statuses = Counter(str(work.metadata["status"]) for work in works)
    blockers = [work for work in works if work.metadata.get("blocking_items")]
    high_risk = [work for work in works if work.metadata.get("risk") in {"high", "critical"}]
    needs_human = [work for work in works if pending_gates(work, documents)]
    tasks = [document for document in documents.values() if document.kind == "task"]
    task_statuses = Counter(str(task.metadata["status"]) for task in tasks)
    print(f"当前工作：{len(works)} 个")
    for status in ("todo", "ready", "doing", "implemented", "verified", "cancelled"):
        if statuses[status]:
            print(f"- {status}: {statuses[status]}")
    print(f"卡住: {len(blockers)}  高风险: {len(high_risk)}  需要人工确认: {len(needs_human)}")
    if tasks:
        summary = ", ".join(f"{status}={count}" for status, count in sorted(task_statuses.items()))
        print(f"任务：{len(tasks)} 个（{summary}）")
    if blockers:
        print("\n卡点：")
        for work in blockers:
            print(f"- {work.id}: {'; '.join(work.metadata['blocking_items'])}")
    stale = [work for work in works if work_outcome(work)]
    if stale:
        print(f"\n结论已不成立（{len(stale)}）：")
        for work in stale:
            print(f"- {work.id} [{work.metadata['status']}] {work.metadata['title']} —— {outcome_summary(work)}")

    # 人工注意力是最稀缺的资源；待签的闸是它唯一该出现的地方，因此单独列出并说明能不能签。
    waiting: list[str] = []
    for work in works:
        if work.metadata["status"] == "cancelled":
            continue
        for gate in GATE_NAMES:
            if gate_passed(work, gate) or not gate_covered_documents(work.id, documents, gate):
                continue
            blockers_now = gate_blockers(work, documents, gate)
            state = "可以签" if not blockers_now else f"未就绪（{blockers_now[0]}）"
            waiting.append(f"- {work.id} {GATE_LABELS[gate]}：{state}")
            break
    if waiting:
        print(f"\n待签的闸（{len(waiting)}）：")
        print("\n".join(waiting))


def work_documents(work_id: str, documents: dict[str, Document]) -> list[Document]:
    return sorted(
        [document for document in documents.values() if document.metadata.get("work") == work_id],
        key=lambda document: document.id,
    )


def rebuild_workflow(work: Document, documents: dict[str, Document]) -> None:
    # 重建的是「流程该长什么样」，不是「过程中发生了什么」。检查结论是后者，
    # 按 阶段+检查名 保留下来——否则重建一次就把已经记录的证据全抹掉。
    recorded = {
        (stage.get("stage"), check_name(check)): check
        for stage in work.metadata.get("workflow") or []
        for check in stage.get("checks") or []
        if isinstance(check, dict) and check.get("result") != "pending"
    }
    generated = select_workflow({**work.metadata, "type": work.metadata["work_type"]})
    for stage in generated["workflow"]:
        for index, check in enumerate(stage["checks"]):
            previous = recorded.get((stage["stage"], check["name"]))
            if previous is not None:
                stage["checks"][index] = dict(previous)
    for field in ("workflow", "required_documents", "required_checks"):
        work.metadata[field] = generated[field]
    bind_workflow_artifacts(work, [work, *work_documents(work.id, documents)])
    synchronize_workflow(work, documents)
    work.metadata["updated_at"] = today()


def command_rebuild_flow(args: argparse.Namespace) -> None:
    """从类型模板和增量规则重建流程；也作为旧 workflow 元数据的迁移入口。"""

    documents = load_documents(args.root)
    index = load_index(args.root)
    works = [document for document in documents.values() if document.kind == "work"]
    if args.work_id:
        works = [work for work in works if work.id == args.work_id]
        if not works:
            raise WorkError(f"不存在工作项 {args.work_id}")
    for work in works:
        rebuild_workflow(work, documents)
    errors, _ = validate_documents(documents, args.root, index)
    if errors:
        raise WorkError("流程重建不满足系统约束：\n- " + "\n- ".join(errors))
    for work in works:
        append_log(work, "根据 WORK Type、风险、影响面和关注项重建流程。")
        write_document(work)
    print(f"✓ 已重建 {len(works)} 个工作项的类型化流程")


def command_flow(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    synchronize_workflow(work, documents)
    print(f"{work.id}  {work.metadata['title']}")
    print(
        f"类型: {work.metadata['work_type']}  状态: {work.metadata['status']}  "
        f"风险: {work.metadata['risk']}  影响: {work.metadata['impact']}"
    )
    for stage in work.metadata["workflow"]:
        artifact_text = ""
        if stage["artifacts"]:
            values = []
            for artifact_id in stage["artifacts"]:
                artifact = documents.get(artifact_id)
                artifact_status = artifact.metadata["status"] if artifact else "missing"
                values.append(f"{artifact_id}:{artifact_status}")
            artifact_text = " [" + ", ".join(values) + "]"
        checks = (
            " checks=" + ",".join(f"{check_name(c)}:{check_result(c)}" for c in stage["checks"])
            if stage["checks"]
            else ""
        )
        print(
            f"- {stage['label']} ({stage['stage']}): "
            f"{stage['requirement']}/{stage['status']}{artifact_text}{checks}"
        )
    if work.metadata.get("blocking_items"):
        print("卡点: " + "; ".join(work.metadata["blocking_items"]))
    print(f"下一步: {next_step_for(work, documents)}")


def next_step_for(work: "Document", documents: dict[str, "Document"]) -> str:
    """把「现在该做什么」集中到一处，避免每个视图各算一遍、算出不同答案。"""
    if work.metadata.get("blocking_items"):
        return "解决 blocking 待确认项并更新上游定义"
    for gate in GATE_NAMES:
        if gate_passed(work, gate) or not gate_covered_documents(work.id, documents, gate):
            continue
        if not gate_blockers(work, documents, gate):
            return f"由负责人签署{GATE_LABELS[gate]}：scripts/work gate {work.id} {gate} --reason \"...\""
        break
    active_stage = next(
        (
            stage
            for stage in work.metadata["workflow"]
            if stage["requirement"] == "required" and stage["status"] not in {"done", "skipped"}
        ),
        None,
    )
    if active_stage:
        return f"推进“{active_stage['label']}”阶段（{active_stage['status']}）"
    if work.metadata["status"] in {"verified", "cancelled"}:
        return "无"
    return f"运行 scripts/work refresh {work.id} 按事实刷新工作状态"


def derive_work_status(work: Document, children: list[Document]) -> str:
    current = work.metadata["status"]
    if current in {"cancelled"}:
        return current
    if work.metadata.get("blocking_items"):
        return "todo"
    tasks = [document for document in children if document.kind == "task" and document.metadata.get("status") != "cancelled"]
    verifies = [document for document in children if document.kind == "verify"]
    if any(doc.metadata.get("status") == "approved" and doc.metadata.get("result") == "pass" for doc in verifies):
        return "verified"
    if tasks and all(task.metadata.get("status") in {"done", "verified"} for task in tasks):
        return "implemented"
    if any(task.metadata.get("status") in {"doing", "done", "verified", "blocked"} for task in tasks):
        return "doing"
    prep = [
        document
        for document in children
        if document.kind in set(work.metadata.get("required_documents", [])) - {"task", "verify", "memory"}
    ]
    if prep and all(is_settled(document) for document in prep) and tasks and all(
        task.metadata.get("status") == "ready" for task in tasks
    ):
        return "ready"
    return "todo"


def settle_record_documents(
    work_id: str, documents: dict[str, "Document"]
) -> list["Document"]:
    """记录类文档写完（review）且依赖已满足时，由工具置为 checked，不占用人的判断。"""
    settled: list[Document] = []
    for document in work_documents(work_id, documents):
        if document.kind not in RECORD_DOCUMENT_KINDS:
            continue
        if document.metadata.get("status") != "review":
            continue
        if not status_dependencies_satisfied(document, documents):
            continue
        document.metadata["status"] = "checked"
        document.metadata["updated_at"] = today()
        append_log(document, "结构与内容校验通过，由工具置为 checked。")
        settled.append(document)
    return settled


def command_refresh(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    settled = settle_record_documents(work.id, documents)
    # 视图被手工改过时，元数据可能毫无变化；不记下来的话 refresh 会提前返回，修不回去。
    old_flow = section(work.body, FLOW_SECTION)
    old_workflow = json.dumps(work.metadata["workflow"], ensure_ascii=False, sort_keys=True)
    bind_workflow_artifacts(work, [work, *work_documents(work.id, documents)])
    synchronize_workflow(work, documents)
    derived = derive_work_status(work, work_documents(work.id, documents))
    old = work.metadata["status"]
    work.metadata["status"] = derived
    synchronize_workflow(work, documents)
    workflow_changed = old_workflow != json.dumps(
        work.metadata["workflow"], ensure_ascii=False, sort_keys=True
    )
    flow_changed = old_flow != section(work.body, FLOW_SECTION)
    if old == derived and not workflow_changed and not settled and not flow_changed:
        print(f"✓ {work.id} 状态无需更新：{old}")
        return
    # 纯视图重绘不是工作历史：不写变更记录，也不动 updated_at，否则修一次手改就留一条噪音。
    if old != derived:
        work.metadata["updated_at"] = today()
        append_log(work, f"根据文档、任务与验证事实刷新状态：{old} → {derived}。")
    elif workflow_changed:
        work.metadata["updated_at"] = today()
        append_log(work, "根据文档、任务与 WORK 事实刷新流程阶段状态。")
    elif settled:
        work.metadata["updated_at"] = today()
        append_log(work, "记录类文档通过校验，由工具定稿。")
    prospective = dict(documents)
    prospective[work.id] = work
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("状态刷新不满足系统约束：\n- " + "\n- ".join(errors))
    write_document(work)
    for document in settled:
        write_document(document)
    if settled:
        print("已由工具定稿：" + ", ".join(f"{d.id}→checked" for d in settled))
    if old == derived:
        print(f"✓ {work.id}: 已同步流程阶段，工作状态保持 {old}")
    else:
        print(f"✓ {work.id}: {old} → {derived}")


def status_dependencies_satisfied(document: Document, documents: dict[str, Document]) -> bool:
    for value in document.metadata.get("depends_on", []):
        target = reference_target(value)
        if target in documents and documents[target].metadata.get("status") not in SATISFIED_DEPENDENCY_STATUSES:
            return False
    return True


def gate_covered_documents(work_id: str, documents: dict[str, "Document"], gate: str) -> list["Document"]:
    kinds = gate_kinds(gate)
    return sorted(
        (
            document
            for document in work_documents(work_id, documents)
            if document.kind in kinds
            and document.metadata.get("status") not in {"deprecated", "superseded", "archived"}
        ),
        key=lambda document: document.id,
    )


def gate_blockers(work: "Document", documents: dict[str, "Document"], gate: str) -> list[str]:
    """闸能不能签，取决于事实是否齐备；这里只检查人做判断前必须成立的前提。"""
    blockers: list[str] = []
    covered = gate_covered_documents(work.id, documents, gate)
    if not covered:
        blockers.append(f"{work.id} 没有该闸覆盖的文档，无需也无法签署")
        return blockers
    unfinished = [document.id for document in covered if document.metadata.get("status") == "draft"]
    if unfinished:
        blockers.append("以下文档仍是 draft，作者尚未声明写完：" + ", ".join(unfinished))
    # 闸会连带定稿记录类文档，但只能定稿已经写完（review）的那些。
    unwritten = sorted(
        {
            documents[target].id
            for document in covered
            for value in document.metadata.get("depends_on", [])
            if (target := reference_target(value)) in documents
            and documents[target].kind in RECORD_DOCUMENT_KINDS
            and documents[target].metadata.get("status") == "draft"
        }
    )
    if unwritten:
        blockers.append(
            "覆盖文档依赖的记录类文档仍是 draft，无法在签闸时一并定稿：" + ", ".join(unwritten)
        )
    if gate == "intent":
        if work.metadata.get("blocking_items"):
            blockers.append("仍有 blocking_items 未澄清：" + "; ".join(work.metadata["blocking_items"]))
    else:
        if not gate_passed(work, "intent"):
            blockers.append("意图闸尚未通过，不能先签验收闸")
        tasks = [
            document
            for document in work_documents(work.id, documents)
            if document.kind == "task" and document.metadata.get("status") != "cancelled"
        ]
        undone = [task.id for task in tasks if task.metadata.get("status") not in {"done", "verified"}]
        if undone:
            blockers.append("以下 TASK 尚未完成：" + ", ".join(undone))
        pending_result = [
            document.id for document in covered if document.metadata.get("result") == "pending"
        ]
        if pending_result:
            blockers.append("以下 VERIFY 还没有记录结论：" + ", ".join(pending_result))
    return blockers


def unsettle_record_documents(
    work_id: str, documents: dict[str, "Document"]
) -> list["Document"]:
    """撤闸的逆操作：依赖重新变得不确定时，工具给出的 checked 也必须收回。"""
    reopened: list[Document] = []
    for document in work_documents(work_id, documents):
        if document.kind not in RECORD_DOCUMENT_KINDS:
            continue
        if document.metadata.get("status") != "checked":
            continue
        if status_dependencies_satisfied(document, documents):
            continue
        document.metadata["status"] = "review"
        document.metadata["updated_at"] = today()
        append_log(document, "上游依赖被重新打开，checked 收回为 review。")
        reopened.append(document)
    return reopened


REQUIREMENT_PATTERN = re.compile(r"(?m)^\s*-\s+((?:REQ|AC)-[0-9]{3})")


def local_requirements(document: "Document") -> list[str]:
    """定义文档正文里声明的 REQ / AC 条目，按出现顺序去重。"""
    return list(dict.fromkeys(REQUIREMENT_PATTERN.findall(document.body)))


def reference_coverage(
    sources: list["Document"], field: str, document_id: str, requirement: str
) -> tuple[str, list["Document"]]:
    """一条要求被谁认领 / 覆盖。

    区分三种状态很重要：锚定引用能定位到具体条目；文档级引用只说明“这份定义有人管”，
    并不保证每条要求都被覆盖；两者都没有才是真正的孤儿。把后两者混为一谈，
    追踪链看起来永远是满的。
    """
    anchored, document_level = [], []
    for source in sources:
        values = source.metadata.get(field) or []
        if f"{document_id}#{requirement}" in values:
            anchored.append(source)
        elif document_id in values:
            document_level.append(source)
    if anchored:
        return "anchored", anchored
    if document_level:
        return "document", document_level
    return "none", []


def command_board(args: argparse.Namespace) -> None:
    documents = load_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    children = work_documents(work.id, documents)
    meta = work.metadata

    print(f"{work.id}  {meta['title']}")
    print(
        f"{meta['work_type']} · {meta['risk']} 风险 · {IMPACT_LABELS.get(meta['impact'], meta['impact'])}"
        f" · {'/'.join(meta['owners'])} · {meta['status']} · 更新于 {meta['updated_at']}"
    )

    outcome = work_outcome(work)
    if outcome:
        print(f"\n⚠ {OUTCOME_LABELS[outcome['state']]}" + (f"：{outcome['by']}" if outcome.get("by") else ""))
        print(f"  {outcome['reason']}")
        print("  下面的流程与要求是当时的事实，不代表当前仓库能力。")

    print("\n闸")
    for gate in GATE_NAMES:
        if gate_passed(work, gate):
            state = "✔ 已通过"
        elif not gate_covered_documents(work.id, documents, gate):
            state = "— 无覆盖文档"
        else:
            blockers = gate_blockers(work, documents, gate)
            state = "○ 可以签" if not blockers else f"· 未就绪（{blockers[0]}）"
        print(f"  {GATE_LABELS[gate]:<4} {state}")

    print("\n流程")
    parts = []
    for stage in meta.get("workflow", []):
        mark = STAGE_SYMBOLS.get(stage["status"], "·")
        parts.append(f"{stage['label']} {mark}")
    print("  " + " → ".join(parts))
    active = next(
        (s for s in meta.get("workflow", []) if s["status"] in {"doing", "ready", "blocked"}), None
    )
    if active:
        print(f"  当前：{active['label']}（{STAGE_STATUS_LABELS.get(active['status'], active['status'])}）")

    checks = [
        (stage, check)
        for stage in meta.get("workflow", [])
        for check in stage.get("checks") or []
    ]
    if checks:
        symbols = {"pass": "✔", "fail": "✖", "not-applicable": "—", "pending": "·", "unrecorded": "?"}
        print("\n检查")
        for stage, check in checks:
            result = check_result(check)
            note = check.get("note") if isinstance(check, dict) else ""
            suffix = f"  {note}" if note else ""
            print(
                f"  {symbols.get(result, '·')} {check_name(check):<24} "
                f"{CHECK_RESULT_LABELS.get(result, result):<6} [{stage['label']}]{suffix}"
            )

    tasks = [d for d in children if d.kind == "task"]
    verifies = [d for d in children if d.kind == "verify"]
    # 只看定义层：EXPERIENCE 与 DECISION 也归意图闸，但它们不声明要求条目。
    definitions = [d for d in children if d.kind in DEFINITION_KINDS]
    print("\n要求")
    if not definitions:
        print("  无定义文档")
    for definition in definitions:
        requirements = local_requirements(definition)
        if not requirements:
            print(f"  {definition.id}  未声明 REQ / AC 条目")
            continue
        claimed = verified = 0
        rows = []
        for requirement in requirements:
            claim_state, claim_sources = reference_coverage(tasks, "implements", definition.id, requirement)
            check_state, check_sources = reference_coverage(verifies, "verifies", definition.id, requirement)
            if check_state != "none" and not any(
                d.metadata.get("status") == "approved" and d.metadata.get("result") == "pass"
                for d in check_sources
            ):
                check_state = "pending"
            claimed += claim_state == "anchored"
            verified += check_state == "anchored"
            symbols = {"anchored": "✔", "document": "~", "pending": "▶", "none": "✖"}
            rows.append(
                f"    {requirement}  认领 {symbols[claim_state]} "
                f"{','.join(d.id for d in claim_sources) or '—':<10} "
                f"验证 {symbols[check_state]} {','.join(d.id for d in check_sources) or '—'}"
            )
        print(f"  {definition.id} · {len(requirements)} 条")
        for row in rows if args.all else rows[:8]:
            print(row)
        if not args.all and len(rows) > 8:
            print(f"    …… 其余 {len(rows) - 8} 条，用 --all 展开")
        print(f"    小计：锚定认领 {claimed}/{len(requirements)} · 锚定验证 {verified}/{len(requirements)}")
        print("    （~ 表示只有文档级引用，没有锚定到具体条目）")

    if tasks:
        print("\n任务")
        for task in tasks:
            print(f"  {task.id} [{task.metadata['status']}] {task.metadata['title']}")

    print("\n卡点")
    blocked = [s for s in meta.get("workflow", []) if s["status"] == "blocked"]
    if meta.get("blocking_items"):
        for item in meta["blocking_items"]:
            print(f"  · {item}")
    for stage in blocked:
        print(f"  · 阶段「{stage['label']}」受阻")
    if not meta.get("blocking_items") and not blocked:
        print("  无")

    print(f"\n下一步: {next_step_for(work, documents)}")


def command_audit(args: argparse.Namespace) -> None:
    """对流程自身做体检。

    §1.3 写着「复杂度应当来自工作本身，而不是来自管理工具」，但此前没有任何机制检验这句话。
    一个自称「文档即开发系统」的东西，应该能对自己做同样的验证——否则它只能增生，不能收缩。
    """
    documents = load_documents(args.root)
    works = [d for d in documents.values() if d.kind == "work"]
    if not works:
        raise WorkError("没有工作项可供体检")
    findings: list[str] = []

    print(f"体检对象：{len(works)} 个工作项、{len(documents)} 份文档\n")

    print("① 分级维度的信息量")
    for field in ("work_type", "risk", "impact"):
        counter = Counter(str(w.metadata.get(field)) for w in works)
        top, count = counter.most_common(1)[0]
        share = count * 100 // len(works)
        print(f"  {field:<10} {len(counter)} 种取值，最高占比 {top} {share}%"
              f"  （{'、'.join(f'{k} {v}' for k, v in counter.most_common())}）")
        if share >= 70:
            findings.append(
                f"{field} 有 {share}% 的工作取同一个值，它已经不产生信息，只产生开销——"
                f"要么改变语义，要么退出门禁只作检索"
            )

    print("\n② 门禁是否可证伪")
    declared_checks: Counter = Counter()
    for work in works:
        for check in work.metadata.get("required_checks", []):
            declared_checks[check] += 1
    print(f"  声明的检查项 {sum(declared_checks.values())} 次："
          f"{'、'.join(f'{k}×{v}' for k, v in declared_checks.most_common())}")
    outcomes: Counter = Counter()
    for work in works:
        for stage in work.metadata.get("workflow", []):
            for check in stage.get("checks") or []:
                outcomes[check_result(check)] += 1
    total_checks = sum(outcomes.values())
    print("  结论分布：" + "、".join(
        f"{CHECK_RESULT_LABELS.get(k, k)} {v}" for k, v in outcomes.most_common()
    ))
    if outcomes["unrecorded"]:
        findings.append(
            f"{outcomes['unrecorded']}/{total_checks} 项检查是历史遗留、从未记录结论——"
            f"它们产生于「检查只是声明」的年代，现在无法追认查没查过"
        )
    if outcomes["pending"]:
        findings.append(f"{outcomes['pending']} 项检查已声明但还没有结论")

    stages: dict[str, Counter] = defaultdict(Counter)
    required_count: Counter = Counter()
    for work in works:
        for stage in work.metadata.get("workflow", []):
            stages[stage["stage"]][stage["status"]] += 1
            if stage["requirement"] == "required":
                required_count[stage["stage"]] += 1
    # 现状只是一个时间点；曾经卡住又放行的阶段必须回看历史才看得见。
    label_to_stage = {
        stage["label"]: stage["stage"]
        for work in works
        for stage in work.metadata.get("workflow", [])
    }
    history: dict[str, Counter] = defaultdict(Counter)
    for work in works:
        for match in re.finditer(r"流程阶段 (.+?)：\S+ → (\w+)", work.body):
            stage = label_to_stage.get(match.group(1).strip())
            if stage:
                history[stage][match.group(2)] += 1

    branching, linear = [], []
    print("\n  阶段分支行为（是否出现过 done 以外的终态）")
    for name, counter in sorted(stages.items(), key=lambda item: -sum(item[1].values())):
        past = history[name]
        detail = "、".join(f"{k} {v}" for k, v in counter.most_common())
        note = f"  历史 {'、'.join(f'{k}×{v}' for k, v in past.most_common())}" if past else ""
        branched = bool(counter["skipped"] or counter["blocked"] or past["skipped"] or past["blocked"])
        (branching if branched else linear).append(name)
        print(f"    {'分支' if branched else '直行'} {name:<13} 必需 {required_count[name]:<3} {detail}{note}")
    if linear:
        findings.append(
            f"{len(linear)} 个阶段（{'、'.join(linear)}）在全部工作里只有 done / 未开始两种状态——"
            f"它们是必经步骤而不是门禁，把它们并列成「阶段」会让流程显得比实际更严格"
        )

    print("\n③ 文档被下游消费的程度")
    referenced: Counter = Counter()
    for document in documents.values():
        for field in REFERENCE_FIELDS:
            for value in document.metadata.get(field, []):
                target = reference_target(value)
                if target in documents and target != document.id:
                    referenced[target] += 1
    by_kind: dict[str, list[Document]] = defaultdict(list)
    for document in documents.values():
        by_kind[document.kind].append(document)
    for kind, items in sorted(by_kind.items(), key=lambda item: -len(item[1])):
        orphans = [d for d in items if not referenced[d.id]]
        print(f"  {kind:<12} {len(items):<3} 份，从未被引用 {len(orphans)}")
        if items and len(orphans) == len(items) and kind not in {"work"}:
            findings.append(f"{kind} 共 {len(items)} 份，没有任何一份被下游引用——它可能是写给流程看的")

    print("\n④ 追踪链完整度")
    total = anchored_claim = anchored_check = 0
    for work in works:
        children = work_documents(work.id, documents)
        tasks = [d for d in children if d.kind == "task"]
        verifies = [d for d in children if d.kind == "verify"]
        for definition in (d for d in children if d.kind in DEFINITION_KINDS):
            for requirement in local_requirements(definition):
                total += 1
                anchored_claim += reference_coverage(tasks, "implements", definition.id, requirement)[0] == "anchored"
                anchored_check += reference_coverage(verifies, "verifies", definition.id, requirement)[0] == "anchored"
    if total:
        print(f"  要求 {total} 条 · 锚定认领 {anchored_claim} · 锚定验证 {anchored_check}")
        if anchored_check * 10 < total:
            findings.append(
                f"{total} 条要求里只有 {anchored_check} 条被 VERIFY 锚定验证——"
                f"「每条要求都验过了吗」这个问题系统答不了"
            )

    print("\n⑤ 拆分形态与 PLAN 的必要性")
    idle_plans = []
    for work in works:
        children = work_documents(work.id, documents)
        tasks = [d for d in children if d.kind == "task"]
        plans = [d for d in children if d.kind == "plan"]
        if plans and len(tasks) <= 1:
            idle_plans.append(work.id)
    task_total = sum(1 for d in documents.values() if d.kind == "task")
    print(f"  TASK {task_total} 个 / 工作 {len(works)} 个 = {task_total / len(works):.1f}")
    print(f"  有 PLAN 但只有 ≤1 个 TASK 的工作：{len(idle_plans)}  {'、'.join(idle_plans) or '无'}")
    if idle_plans:
        findings.append(
            f"{len(idle_plans)} 个工作有 PLAN 却只有一个任务，PLAN 能写的并行与依赖在这里是空的——"
            f"它的触发条件应该挂拆分形态，而不是风险"
        )

    stuck = [
        work.id
        for work in works
        if work.metadata.get("status") not in {"verified", "cancelled"}
        and not work.metadata.get("blocking_items")
        and all(gate_passed(work, gate) for gate in GATE_NAMES)
        and all(
            stage["status"] in {"done", "skipped"}
            for stage in work.metadata.get("workflow", [])
            if stage["requirement"] == "required"
        )
    ]
    print("\n⑥ 有没有推不动的状态")
    print(f"  事实齐备但状态未收口的工作：{len(stuck)}  {'、'.join(stuck) or '无'}")
    if stuck:
        findings.append(
            f"{len(stuck)} 个工作的必需阶段和两道闸都已完成，状态却推不动——"
            f"存在任何命令都出不去的状态，这类死锁比缺功能更难发现"
        )

    print("\n观察")
    if not findings:
        print("  没有发现流程本身制造的多余复杂度。")
    for index, finding in enumerate(findings, start=1):
        print(f"  {index}. {finding}")


def command_outcome(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")

    if args.clear:
        if work_outcome(work) is None:
            raise WorkError(f"{work.id} 的结论本来就成立，无需清除")
        work.metadata.pop("outcome", None)
        append_log(work, f"撤销「结论不再成立」的标记。原因：{args.reason}")
        summary = f"✓ {work.id} 的结论重新视为成立"
    else:
        if args.state is None:
            raise WorkError("需要指定 superseded 或 invalidated，或使用 --clear")
        outcome: dict[str, Any] = {"state": args.state, "reason": args.reason}
        if args.by:
            outcome["by"] = args.by
        work.metadata["outcome"] = outcome
        append_log(work, f"{OUTCOME_LABELS[args.state]}{('：' + args.by) if args.by else ''}。原因：{args.reason}")
        summary = f"✓ {work.id} 标记为{OUTCOME_LABELS[args.state]}" + (f"（{args.by}）" if args.by else "")

    work.metadata["updated_at"] = today()
    prospective = {**documents, work.id: work}
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("结论标记不满足系统约束：\n- " + "\n- ".join(errors))
    write_document(work)
    print(summary)
    print("提示：工作状态保持不变——它确实走完过流程，改状态等于篡改历史。")


def unanchored_acceptance_criteria(
    work_id: str, documents: dict[str, "Document"]
) -> list[str]:
    """没有被任何 VERIFY 锚定到条目的验收标准。

    放在签闸时提示而不是 check 里报警：历史上 26 个工作一条锚点都没有，
    每次 check 刷 17 条警告只会训练人忽略警告。签闸是「即将认证做完了」的那一刻，
    提示落在这里才有人看。
    """
    children = work_documents(work_id, documents)
    verifies = [d for d in children if d.kind == "verify"]
    missing: list[str] = []
    for definition in (d for d in children if d.kind in DEFINITION_KINDS):
        for requirement in local_requirements(definition):
            if not requirement.startswith("AC-"):
                continue
            if reference_coverage(verifies, "verifies", definition.id, requirement)[0] != "anchored":
                missing.append(f"{definition.id}#{requirement}")
    return missing


def command_check_result(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")

    matches = [
        (stage, check)
        for stage in work.metadata.get("workflow", [])
        for check in stage.get("checks") or []
        if check_name(check) == args.check
    ]
    if not matches:
        declared = sorted(
            {
                check_name(check)
                for stage in work.metadata.get("workflow", [])
                for check in stage.get("checks") or []
            }
        )
        raise WorkError(
            f"{work.id} 没有声明检查项 {args.check}；已声明的是：{'、'.join(declared) or '无'}"
        )

    for stage, check in matches:
        previous = check_result(check)
        check["result"] = args.result
        check["note"] = args.reason
        print(f"✓ {work.id} 阶段「{stage['label']}」的 {args.check}：{previous} → {args.result}")

    work.metadata["updated_at"] = today()
    append_log(
        work,
        f"检查项 {args.check} 记录结论：{CHECK_RESULT_LABELS[args.result]}。原因：{args.reason}",
    )
    # 结论变化会解除阶段的推进限制，必须重新推导一次，否则阶段状态与事实不符。
    prospective = {**documents, work.id: work}
    bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
    synchronize_workflow(work, prospective)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("记录检查结论不满足系统约束：\n- " + "\n- ".join(errors))
    write_document(work)


def command_gate(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    gate = args.gate
    label = GATE_LABELS[gate]
    gates = work_gates(work)
    covered = gate_covered_documents(work.id, documents, gate)

    if args.revoke:
        if gates[gate] != "passed":
            raise WorkError(f"{work.id} 的{label}当前不是 passed，无需撤回")
        # 工作状态是从闸覆盖的文档推导出来的；先退状态再撤闸，否则推导链自相矛盾。
        locked = {"intent": {"doing", "implemented", "verified"},
                  "acceptance": {"verified"}}[gate]
        if work.metadata["status"] in locked:
            raise WorkError(
                f"{work.id} 当前是 {work.metadata['status']}，该状态正建立在{label}之上，不能直接撤回。\n"
                f"请先运行：scripts/work set-status {work.id} doing --reason \"...\""
            )
        gates[gate] = "pending"
        demoted = [
            document
            for document in covered
            if document.metadata.get("status") == "approved"
        ]
        for document in demoted:
            document.metadata["status"] = "review"
            document.metadata["updated_at"] = today()
            append_log(document, f"{label}被撤回：approved → review。原因：{args.reason}")
        # 与签署对称：连带定稿的记录类文档也要沿依赖链一起收回。
        working = dict(documents)
        for document in demoted:
            working[document.id] = document
        reopened: list[Document] = []
        while True:
            batch = unsettle_record_documents(work.id, working)
            if not batch:
                break
            for document in batch:
                working[document.id] = document
            reopened.extend(batch)
        changed = demoted + reopened
        summary = f"✓ {work.id} 的{label}已撤回"
    else:
        if gates[gate] == "passed":
            raise WorkError(f"{work.id} 的{label}已经通过；如需重新审核请先 --revoke")
        blockers = gate_blockers(work, documents, gate)
        if blockers:
            raise WorkError(f"{work.id} 的{label}还不能签署：\n- " + "\n- ".join(blockers))
        gates[gate] = "passed"
        for stage in work.metadata.get("workflow", []):
            for check in stage.get("checks") or []:
                if check_name(check) in GATE_OWNED_CHECKS[gate] and check_result(check) == "pending":
                    check["result"] = "pass"
                    check["note"] = f"{label}签署时确认：{args.reason}"
        promoted = [
            document
            for document in covered
            if document.metadata.get("status") in {"draft", "review"}
        ]
        for document in promoted:
            previous = document.metadata["status"]
            document.metadata["status"] = "approved"
            document.metadata["updated_at"] = today()
            append_log(document, f"{label}通过：{previous} → approved。原因：{args.reason}")
        # 决定类与记录类在依赖链上交替出现（CHANGE → DESIGN → DECISION → PLAN）。
        # 分两次处理会互相卡住：闸要求 DECISION 的依赖 DESIGN 已定稿，而 DESIGN 又要求
        # CHANGE 已定稿，CHANGE 只能由这道闸给出。所以签闸后在同一次事务里推进到不动点。
        working = dict(documents)
        for document in promoted:
            working[document.id] = document
        settled: list[Document] = []
        while True:
            batch = settle_record_documents(work.id, working)
            if not batch:
                break
            for document in batch:
                working[document.id] = document
            settled.extend(batch)
        changed = promoted + settled
        summary = f"✓ {work.id} 的{label}已通过"

    work.metadata["gates"] = gates
    work.metadata["updated_at"] = today()
    append_log(work, f"{label}：{gates[gate]}。原因：{args.reason}")

    prospective = dict(documents)
    prospective[work.id] = work
    for document in changed:
        prospective[document.id] = document
    bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
    synchronize_workflow(work, prospective)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("闸状态变更不满足系统约束：\n- " + "\n- ".join(errors))

    write_document(work)
    for document in changed:
        write_document(document)
    print(summary)
    if gate == "acceptance" and not args.revoke:
        missing = unanchored_acceptance_criteria(work.id, prospective)
        if missing:
            shown = "、".join(missing[:5])
            more = f" 等 {len(missing)} 条" if len(missing) > 5 else ""
            print(
                f"提示：{shown}{more} 没有被任何 VERIFY 锚定验证。\n"
                f"      「每条验收标准都验过了吗」目前只能靠人读 VERIFY 正文自己对。\n"
                f"      补锚点：scripts/work link <VERIFY> --relation verifies --to <定义>#<AC>"
            )
    if changed:
        print("同时变更：" + ", ".join(f"{d.id}→{d.metadata['status']}" for d in changed))
    else:
        print("没有需要连带变更的文档")


def command_set_status(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    document = require_document(documents, args.document_id)
    allowed = WORK_STATUSES if document.kind == "work" else TASK_STATUSES if document.kind == "task" else DOCUMENT_STATUSES
    if args.status not in allowed:
        raise WorkError(f"{document.kind} 不支持状态 {args.status}")
    old = document.metadata["status"]
    transitions = WORK_TRANSITIONS if document.kind == "work" else TASK_TRANSITIONS if document.kind == "task" else DOCUMENT_TRANSITIONS
    if args.status not in transitions[old]:
        targets = ", ".join(sorted(transitions[old])) or "无"
        raise WorkError(f"{document.id} 不能从 {old} 进入 {args.status}；允许的下一状态：{targets}")
    if args.status == "approved" and document.kind in INTENT_GATE_KINDS | ACCEPTANCE_GATE_KINDS:
        gate = "intent" if document.kind in INTENT_GATE_KINDS else "acceptance"
        raise WorkError(
            f"{document.id} 属于{GATE_LABELS[gate]}覆盖的文档，不再逐份审批。\n"
            f"请改用：scripts/work gate {document.metadata['work']} {gate} --reason \"...\""
        )
    if args.status == "checked" and document.kind not in RECORD_DOCUMENT_KINDS:
        raise WorkError(
            f"checked 只用于记录类文档（{', '.join(sorted(RECORD_DOCUMENT_KINDS))}）；"
            f"{document.id} 是 {document.kind}"
        )
    if args.status in {"approved", "checked", "ready", "doing", "done", "verified"} and not status_dependencies_satisfied(document, documents):
        raise WorkError(f"{document.id} 仍有未完成依赖，不能进入 {args.status}")
    if document.kind == "verify" and args.result:
        document.metadata["result"] = args.result
    if document.kind == "verify" and args.status == "approved" and document.metadata.get("result") == "pending":
        raise WorkError("验证结果进入 approved 前必须通过 --result 记录结论")
    document.metadata["status"] = args.status
    document.metadata["updated_at"] = today()
    append_log(document, f"状态变更：{old} → {args.status}。原因：{args.reason}")
    prospective = dict(documents)
    prospective[document.id] = document
    related_work = document if document.kind == "work" else prospective[document.metadata["work"]]
    bind_workflow_artifacts(
        related_work,
        [related_work, *work_documents(related_work.id, prospective)],
    )
    synchronize_workflow(related_work, prospective)
    prospective[related_work.id] = related_work
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("状态变更不满足系统约束：\n- " + "\n- ".join(errors))
    write_document(document)
    if related_work.id != document.id:
        related_work.metadata["updated_at"] = today()
        write_document(related_work)
    print(f"✓ {document.id}: {old} → {args.status}")


def command_set_stage(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    work = require_document(documents, args.work_id)
    if work.kind != "work":
        raise WorkError(f"{args.work_id} 不是工作项")
    stage = next(
        (candidate for candidate in work.metadata["workflow"] if candidate["stage"] == args.stage),
        None,
    )
    if stage is None:
        raise WorkError(f"{work.id} 的实际流程中不存在阶段 {args.stage}")
    if stage["artifacts"] or stage["stage"] == "clarify":
        raise WorkError("有 artifacts 的阶段由文档/TASK/VERIFY 状态推进；clarify 由 blocking_items 推进")
    if args.status not in STAGE_PROGRESS:
        raise WorkError(f"不支持阶段状态 {args.status}")
    old = stage["status"]
    if args.status not in STAGE_TRANSITIONS[old]:
        targets = ", ".join(sorted(STAGE_TRANSITIONS[old])) or "无"
        raise WorkError(f"阶段 {args.stage} 不能从 {old} 进入 {args.status}；允许：{targets}")
    if args.status == "skipped" and stage["requirement"] == "required":
        raise WorkError(f"必做阶段 {args.stage} 不能跳过")
    if args.status in {"ready", "doing", "done"}:
        for candidate in work.metadata["workflow"]:
            if candidate is stage:
                break
            if candidate["requirement"] == "required" and candidate["status"] != "done":
                raise WorkError(f"前置必做阶段“{candidate['label']}”尚未完成")
    stage["status"] = args.status
    stage["status_source"] = "manual"
    work.metadata["updated_at"] = today()
    append_log(work, f"流程阶段 {stage['label']}：{old} → {args.status}。原因：{args.reason}")
    prospective = dict(documents)
    prospective[work.id] = work
    synchronize_workflow(work, prospective)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("阶段状态变化不满足系统约束：\n- " + "\n- ".join(errors))
    write_document(work)
    print(f"✓ {work.id}/{args.stage}: {old} → {args.status}")


def command_link(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    document = require_document(documents, args.document_id)
    # 引用可以锚定到条目（FEATURE-002#REQ-001）。new-doc --implements 一直支持这种写法，
    # link 却按整份文档 id 查找——同一种引用两套解析，追踪链会因此填不满。
    reference = args.target_id
    target = require_document(documents, reference_target(reference) or reference)
    if "#" in reference:
        anchor = reference.split("#", 1)[1]
        if anchor not in target.body:
            raise WorkError(f"{target.id} 中不存在局部编号 {anchor}")
    if args.relation not in REFERENCE_FIELDS:
        raise WorkError(f"不支持关系 {args.relation}")
    values = list(document.metadata.get(args.relation, []))
    if reference not in values:
        values.append(reference)
    document.metadata[args.relation] = values
    document.metadata["updated_at"] = today()
    prospective = dict(documents)
    prospective[document.id] = document
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("关联会破坏系统约束：\n- " + "\n- ".join(errors))
    write_document(document)
    print(f"✓ {document.id} --{args.relation}--> {reference}")


def command_trace(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    start = require_document(documents, args.document_id)
    edges: dict[str, list[tuple[str, str]]] = defaultdict(list)
    for document in documents.values():
        for field in REFERENCE_FIELDS:
            for value in document.metadata.get(field, []):
                target = reference_target(value)
                if target in documents:
                    edges[document.id].append((field, target))
                    edges[target].append((f"reverse:{field}", document.id))
        outcome_target = (work_outcome(document) or {}).get("by") if document.kind == "work" else None
        if outcome_target in documents:
            edges[document.id].append(("outcome:被取代于", outcome_target))
            edges[outcome_target].append(("reverse:outcome:取代了", document.id))
        if document.kind != "work" and document.metadata.get("work") in documents:
            work_id = document.metadata["work"]
            edges[document.id].append(("belongs_to", work_id))
            edges[work_id].append(("contains", document.id))
    # 深度优先：关系和它指向的文档必须打在同一行。
    # 原先是广度优先且先打关系再入队，于是一层的关系行全挤在一起、目标在后面平铺，读不出结构。
    seen: set[str] = set()

    def walk(document_id: str, relation: str, depth: int) -> None:
        document = documents[document_id]
        indent = "  " * depth
        arrow = f"↳ {relation}  " if relation else ""
        line = (
            f"{indent}{arrow}{document.id} "
            f"[{document.kind}/{document.metadata['status']}] {document.metadata['title']}"
        )
        print(line)
        if document_id in seen:
            return
        seen.add(document_id)
        if depth >= args.depth:
            return
        # 已展开过的节点折成一行摘要：否则每条回边都占一行，结构被重复淹没。
        revisits = []
        for next_relation, target in sorted(set(edges[document_id])):
            if target in seen:
                revisits.append(f"{next_relation} {target}")
            else:
                walk(target, next_relation, depth + 1)
        if revisits:
            print(f"{indent}  · 另有 {len(revisits)} 条指向已展开节点：{'、'.join(revisits)}")

    walk(start.id, "", 0)


def command_context(args: argparse.Namespace) -> None:
    documents, _ = checked_documents(args.root)
    task = require_document(documents, args.task_id)
    if task.kind != "task":
        raise WorkError("context 入口必须是 TASK")
    work = require_document(documents, task.metadata["work"])
    selected: dict[str, Document] = {work.id: work, task.id: task}
    for value in task.metadata.get("depends_on", []) + task.metadata.get("implements", []) + task.metadata.get("related", []):
        target = reference_target(value)
        if target in documents:
            selected[target] = documents[target]
    for document in work_documents(work.id, documents):
        if document.kind in {"decision", "memory"} and document.metadata.get("status") in FINAL_DOCUMENT_STATUSES:
            selected[document.id] = document
    print("# 智能体任务上下文包")
    print()
    print("## 项目规则入口")
    print()
    for path in ("AGENTS.md", "CLAUDE.md", "docs/README.md"):
        if (args.root / path).is_file():
            print(f"- {path}")
    print()
    print("## 任务代码边界")
    print()
    print("- 可查看：" + ", ".join(task.metadata.get("read_paths", [])))
    print("- 可修改：" + ", ".join(task.metadata.get("write_paths", [])))
    print("- 禁止修改：" + ", ".join(task.metadata.get("forbidden_paths", [])))
    for document in sorted(selected.values(), key=lambda item: (item.kind != "work", item.id)):
        print()
        print(f"---\n\n# 来源：{document.path.relative_to(args.root)}\n")
        print(render_document(document), end="")


def command_archive(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    document = require_document(documents, args.document_id)
    if document.kind in {"work", "task"}:
        raise WorkError("WORK/TASK 使用 cancelled 或完成状态保留；不能直接归档")
    if "archived" not in DOCUMENT_TRANSITIONS[document.metadata["status"]]:
        raise WorkError(f"{document.id} 当前状态不能归档：{document.metadata['status']}")
    document.metadata["status"] = "archived"
    document.metadata["updated_at"] = today()
    append_log(document, f"归档：{args.reason}")
    prospective = dict(documents)
    prospective[document.id] = document
    work = prospective[document.metadata["work"]]
    bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
    synchronize_workflow(work, prospective)
    prospective[work.id] = work
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("归档会破坏系统约束：\n- " + "\n- ".join(errors))
    write_document(document)
    work.metadata["updated_at"] = today()
    write_document(work)
    print(f"✓ {document.id} 已在所属工作项目录中标记为 archived")


def command_deprecate(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    document = require_document(documents, args.document_id)
    if document.kind in {"work", "task"}:
        raise WorkError("WORK/TASK 不能使用 deprecated")
    if "deprecated" not in DOCUMENT_TRANSITIONS[document.metadata["status"]]:
        raise WorkError(f"{document.id} 当前状态不能废弃：{document.metadata['status']}")
    old = document.metadata["status"]
    document.metadata["status"] = "deprecated"
    document.metadata["deprecated"] = args.reason
    document.metadata["updated_at"] = today()
    append_log(document, f"废弃：{args.reason}")
    prospective = {**documents, document.id: document}
    work = prospective[document.metadata["work"]]
    bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
    synchronize_workflow(work, prospective)
    prospective[work.id] = work
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("废弃会破坏系统约束：\n- " + "\n- ".join(errors))
    write_document(document)
    work.metadata["updated_at"] = today()
    write_document(work)
    print(f"✓ {document.id}: {old} → deprecated")


def command_supersede(args: argparse.Namespace) -> None:
    documents, index = checked_documents(args.root)
    old = require_document(documents, args.document_id)
    new = require_document(documents, args.by)
    if old.kind in {"work", "task"} or new.kind != old.kind:
        raise WorkError("替代关系要求两个同类型的非 WORK/TASK 文档")
    if not is_settled(old) or not is_settled(new):
        raise WorkError("只有两份都已定稿（approved 或 checked）的同类型文档才能建立替代关系")
    old.metadata["status"] = "superseded"
    old.metadata["deprecated"] = args.reason
    old.metadata["updated_at"] = today()
    new.metadata["supersedes"] = old.id
    new.metadata["updated_at"] = today()
    append_log(old, f"由 {new.id} 替代：{args.reason}")
    prospective = {**documents, old.id: old, new.id: new}
    works = []
    for work_id in dict.fromkeys(d.metadata.get("work") for d in (old, new)):
        work = prospective.get(work_id)
        if work is None:
            continue
        bind_workflow_artifacts(work, [work, *work_documents(work.id, prospective)])
        synchronize_workflow(work, prospective)
        prospective[work.id] = work
        works.append(work)
    errors, _ = validate_documents(prospective, args.root, index)
    if errors:
        raise WorkError("替代会破坏系统约束：\n- " + "\n- ".join(errors))
    write_document(old)
    write_document(new)
    for work in works:
        work.metadata["updated_at"] = today()
        write_document(work)
    print(f"✓ {old.id} 已由 {new.id} 替代")


def command_sync_works(args: argparse.Namespace) -> None:
    documents = load_documents(args.root)
    sync_works_index(args.root, documents)
    count = sum(document.kind == "work" for document in documents.values())
    print(f"✓ 已更新 development/WORKS.md（{count} 个工作项）")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="管理 cherry-oj 的统一工作项与开发文档")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1], help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("check", help="校验元数据、状态、流程、引用和依赖").set_defaults(handler=command_check)
    subparsers.add_parser("sync-works", help="按 00-work.md 刷新 WORKS.md 总览").set_defaults(
        handler=command_sync_works
    )

    new_parser = subparsers.add_parser("new", help="创建工作项并生成所需文档")
    new_parser.add_argument("--title", required=True)
    new_parser.add_argument("--type", dest="work_type", choices=sorted(WORK_TYPES), required=True)
    new_parser.add_argument("--risk", choices=RISKS, required=True)
    new_parser.add_argument("--impact", choices=sorted(IMPACTS), required=True)
    new_parser.add_argument("--concern", action="append", choices=sorted(CONCERNS), default=[])
    new_parser.add_argument("--owner", action="append", required=True)
    new_parser.add_argument("--blocking", action="append", default=[])
    new_parser.add_argument("--not-reversible", action="store_true")
    new_parser.add_argument("--data-change", action="store_true")
    new_parser.add_argument("--public-api-change", action="store_true")
    new_parser.add_argument("--security-sensitive", action="store_true")
    new_parser.add_argument("--user-visible", action="store_true")
    new_parser.set_defaults(handler=command_new)

    doc_parser = subparsers.add_parser("new-doc", help="向现有工作项添加文档")
    doc_parser.add_argument("--work", dest="work_id", required=True)
    doc_parser.add_argument("--type", choices=[kind for kind in DOCUMENT_TYPES if kind != "work"], required=True)
    doc_parser.add_argument("--title", required=True)
    doc_parser.add_argument("--owner", action="append")
    doc_parser.add_argument("--depends-on", action="append", default=[])
    doc_parser.add_argument("--related", action="append", default=[])
    doc_parser.add_argument("--implements", action="append", default=[])
    doc_parser.add_argument("--verifies", action="append", default=[])
    doc_parser.add_argument("--read-path", action="append", default=[])
    doc_parser.add_argument("--write-path", action="append", default=[])
    doc_parser.add_argument("--forbidden-path", action="append", default=[])
    doc_parser.set_defaults(handler=command_new_doc)

    list_parser = subparsers.add_parser("list", help="查询工作项和文档")
    list_parser.add_argument("--type", choices=DOCUMENT_TYPES)
    list_parser.add_argument("--status")
    list_parser.add_argument("--work")
    list_parser.add_argument("--needs-human", action="store_true")
    list_parser.set_defaults(handler=command_list)

    show_parser = subparsers.add_parser("show", help="显示一份文档")
    show_parser.add_argument("document_id")
    show_parser.set_defaults(handler=command_show)

    subparsers.add_parser("overview", help="显示项目级工作、风险和卡点总览").set_defaults(
        handler=command_overview
    )

    flow_parser = subparsers.add_parser("flow", help="显示工作项流程与下一步")
    flow_parser.add_argument("work_id")
    flow_parser.set_defaults(handler=command_flow)

    rebuild_parser = subparsers.add_parser(
        "rebuild-flow", help="按 WORK Type、风险与影响面重新生成流程"
    )
    rebuild_parser.add_argument("work_id", nargs="?")
    rebuild_parser.set_defaults(handler=command_rebuild_flow)

    refresh_parser = subparsers.add_parser("refresh", help="按事实刷新工作项状态")
    refresh_parser.add_argument("work_id")
    refresh_parser.set_defaults(handler=command_refresh)

    status_parser = subparsers.add_parser("set-status", help="记录有理由的状态变化")
    status_parser.add_argument("document_id")
    status_parser.add_argument("status")
    status_parser.add_argument("--reason", required=True)
    status_parser.add_argument("--result", choices=("pending", "pass", "fail", "partial"))
    status_parser.set_defaults(handler=command_set_status)

    stage_parser = subparsers.add_parser(
        "set-stage", help="推进没有独立 artifact 的流程阶段"
    )
    stage_parser.add_argument("work_id")
    stage_parser.add_argument("stage")
    stage_parser.add_argument("status", choices=sorted(STAGE_PROGRESS))
    stage_parser.add_argument("--reason", required=True)
    stage_parser.set_defaults(handler=command_set_stage)

    link_parser = subparsers.add_parser("link", help="建立文档关系")
    link_parser.add_argument("document_id")
    link_parser.add_argument("--relation", choices=REFERENCE_FIELDS, required=True)
    link_parser.add_argument("--to", dest="target_id", required=True)
    link_parser.set_defaults(handler=command_link)

    trace_parser = subparsers.add_parser("trace", help="追踪上下游关系")
    trace_parser.add_argument("document_id")
    trace_parser.add_argument("--depth", type=int, default=3)
    trace_parser.set_defaults(handler=command_trace)

    context_parser = subparsers.add_parser("context", help="组装智能体任务上下文包")
    context_parser.add_argument("task_id")
    context_parser.set_defaults(handler=command_context)

    subparsers.add_parser("audit", help="对流程自身做体检：哪些门禁从未拦过东西").set_defaults(
        handler=command_audit
    )

    check_result_parser = subparsers.add_parser(
        "check-result", help="记录某个检查项的结论"
    )
    check_result_parser.add_argument("work_id")
    check_result_parser.add_argument("check")
    check_result_parser.add_argument(
        "result", choices=["pass", "fail", "not-applicable"]
    )
    check_result_parser.add_argument("--reason", required=True)
    check_result_parser.set_defaults(handler=command_check_result)

    outcome_parser = subparsers.add_parser(
        "outcome", help="标记工作结论是否仍然成立（不改变 status）"
    )
    outcome_parser.add_argument("work_id")
    outcome_parser.add_argument("state", nargs="?", choices=sorted(OUTCOME_STATES))
    outcome_parser.add_argument("--by", help="接替它的工作项，superseded 必填")
    outcome_parser.add_argument("--reason", required=True)
    outcome_parser.add_argument("--clear", action="store_true", help="撤销标记，重新视为成立")
    outcome_parser.set_defaults(handler=command_outcome)

    board_parser = subparsers.add_parser("board", help="以项目管理视角查看单个工作项")
    board_parser.add_argument("work_id")
    board_parser.add_argument("--all", action="store_true", help="展开全部要求条目")
    board_parser.set_defaults(handler=command_board)

    gate_parser = subparsers.add_parser("gate", help="签署或撤回工作项的意图闸/验收闸")
    gate_parser.add_argument("work_id")
    gate_parser.add_argument("gate", choices=GATE_NAMES)
    gate_parser.add_argument("--reason", required=True)
    gate_parser.add_argument(
        "--revoke", action="store_true", help="撤回该闸，并把它覆盖的 approved 文档退回 review"
    )
    gate_parser.set_defaults(handler=command_gate)

    archive_parser = subparsers.add_parser("archive", help="归档不再活跃的文档")
    archive_parser.add_argument("document_id")
    archive_parser.add_argument("--reason", required=True)
    archive_parser.set_defaults(handler=command_archive)

    deprecate_parser = subparsers.add_parser("deprecate", help="废弃一份文档")
    deprecate_parser.add_argument("document_id")
    deprecate_parser.add_argument("--reason", required=True)
    deprecate_parser.set_defaults(handler=command_deprecate)

    supersede_parser = subparsers.add_parser("supersede", help="用新文档替代旧文档")
    supersede_parser.add_argument("document_id")
    supersede_parser.add_argument("--by", required=True)
    supersede_parser.add_argument("--reason", required=True)
    supersede_parser.set_defaults(handler=command_supersede)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.handler(args)
        if args.command in {
            "new",
            "new-doc",
            "rebuild-flow",
            "refresh",
            "set-status",
            "set-stage",
            "link",
            "gate",
            "check-result",
            "outcome",
            "archive",
            "deprecate",
            "supersede",
        }:
            sync_works_index(args.root, load_documents(args.root))
    except (WorkError, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
