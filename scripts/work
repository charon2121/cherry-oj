#!/usr/bin/env python3
"""可选的工作记录助手；不管理授权、签闸或阶段状态。"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TYPES = {
    "product": "功能",
    "infra": "基建",
    "fix": "修复",
    "maintenance": "维护",
    "improvement": "改进",
}


def inside(root: Path, relative: str) -> Path:
    """拒绝绝对路径、上级路径和指向仓库外的符号链接。"""
    raw = Path(relative)
    target = (root / raw).resolve()
    if raw.is_absolute() or ".." in raw.parts or not target.is_relative_to(root.resolve()):
        raise ValueError(f"路径越出仓库：{relative}")
    return target


def entries(root: Path) -> list[Path]:
    return [
        inside(root, path.relative_to(root).as_posix())
        for path in sorted((root / "development/works").glob("*/00-work.md"))
    ]


def title(path: Path) -> str:
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    raise ValueError(f"工作入口缺少标题：{path}")


def create(root: Path, kind: str, slug: str, heading: str, day: str) -> Path:
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", slug):
        raise ValueError("短名请使用小写英文、数字和连字符，以字母开头，最长 64 字符")
    if not heading.strip() or "\n" in heading or "\r" in heading:
        raise ValueError("标题应为非空的一行文字")
    if date.fromisoformat(day).isoformat() != day:
        raise ValueError("日期请使用 YYYY-MM-DD")
    folder = inside(root, f"development/works/{day}-{slug}")
    template = (root / "development/templates/overview.md").read_text(encoding="utf-8")
    content = template.replace("{{title}}", heading.strip()).replace("{{type}}", TYPES[kind]).replace("{{date}}", day)
    # 存在就失败，不能覆盖历史或正在进行的工作。
    folder.mkdir(parents=True, exist_ok=False)
    destination = folder / "00-work.md"
    destination.write_text(content, encoding="utf-8")
    return destination


def find(root: Path, identifier: str) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,95}", identifier):
        raise ValueError("请输入工作目录名或已有文档编号")
    primary = inside(root, f"development/works/{identifier}/00-work.md")
    if primary.is_file():
        return primary
    candidates = sorted((root / "development/works").glob(f"*/*-{identifier}.md"))
    if len(candidates) != 1:
        raise ValueError(f"未找到唯一文档：{identifier}")
    return inside(root, candidates[0].relative_to(root).as_posix())


def check(root: Path) -> list[str]:
    errors: list[str] = []
    for path in entries(root):
        try:
            inside(root, path.relative_to(root).as_posix())
            title(path)
        except (OSError, ValueError) as exc:
            errors.append(str(exc))
    manifest_path = root / "development/migration.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if manifest["version"] != 1:
            raise ValueError("不支持的迁移清单版本")
        files = dict(manifest["files"])
        snapshot = manifest["system_snapshot"]
        files[snapshot["path"]] = snapshot["sha256"]
        for work in manifest["works"]:
            if work["original"] not in files:
                errors.append(f"原始入口未列入校验：{work['id']}")
            if not inside(root, f"development/works/{work['id']}/00-work.md").is_file():
                errors.append(f"工作入口丢失：{work['id']}")
        for relative, expected in files.items():
            path = inside(root, relative)
            if not path.is_file():
                errors.append(f"历史原件丢失：{relative}")
            elif hashlib.sha256(path.read_bytes()).hexdigest() != expected:
                errors.append(f"历史原件发生变化：{relative}")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        errors.append(f"迁移清单无法校验：{exc}")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    new = commands.add_parser("new", help="明确启用文档流程后，可选地创建一份工作说明")
    new.add_argument("type", choices=tuple(TYPES))
    new.add_argument("slug", help="简短英文目录名")
    new.add_argument("--title", required=True)
    new.add_argument("--date", default=date.today().isoformat())
    commands.add_parser("list", help="列出工作入口，不推导状态")
    show = commands.add_parser("show", help="查看工作目录或原文档编号")
    show.add_argument("identifier")
    commands.add_parser("check", help="检查入口与迁移原件，不判断授权或完成")
    args = parser.parse_args()
    try:
        if args.command == "new":
            path = create(ROOT, args.type, args.slug, args.title, args.date)
            print(f"已创建草稿：{path.relative_to(ROOT)}；请用具体内容替换写作提示。")
        elif args.command == "list":
            for path in entries(ROOT):
                print(f"{path.parent.name}\t{title(path)}")
        elif args.command == "show":
            print(find(ROOT, args.identifier).read_text(encoding="utf-8"), end="")
        else:
            errors = check(ROOT)
            if errors:
                print("\n".join(errors), file=sys.stderr)
                return 1
            print(f"{len(entries(ROOT))} 个工作入口与历史原件完整；未判断授权、进度或验收。")
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
