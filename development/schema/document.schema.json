{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cherry-oj.local/schemas/development-document.schema.json",
  "title": "cherry-oj development document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "work",
    "owners",
    "depends_on",
    "related",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
    "type": {
      "enum": [
        "work",
        "product",
        "feature",
        "capability",
        "issue",
        "change",
        "improvement",
        "experience",
        "design",
        "decision",
        "plan",
        "task",
        "verify",
        "memory"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "todo",
        "ready",
        "doing",
        "implemented",
        "verified",
        "cancelled",
        "done",
        "blocked",
        "draft",
        "review",
        "checked",
        "approved",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "work": { "type": ["string", "null"], "pattern": "^WORK-[0-9]{3,}$" },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "depends_on": { "$ref": "#/$defs/references" },
    "related": { "$ref": "#/$defs/references" },
    "implements": { "$ref": "#/$defs/references" },
    "verifies": { "$ref": "#/$defs/references" },
    "supersedes": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
    "deprecated": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "work_type": { "enum": ["product", "infra", "fix", "maintenance", "improvement"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "impact": { "enum": ["local", "multi-module", "system"] },
    "concerns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "security",
          "privacy",
          "data",
          "performance",
          "reliability",
          "observability",
          "compatibility",
          "accessibility",
          "cost",
          "release"
        ]
      }
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "label",
          "requirement",
          "status",
          "status_source",
          "artifacts",
          "checks",
          "source",
          "reason"
        ],
        "properties": {
          "stage": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "requirement": { "enum": ["required", "optional"] },
          "status": { "enum": ["pending", "ready", "doing", "done", "skipped", "blocked"] },
          "status_source": { "enum": ["derived", "manual"] },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" }
          },
          "checks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "required_documents": { "type": "array", "items": { "type": "string" } },
    "required_checks": { "type": "array", "items": { "type": "string" } },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "acceptance"],
      "properties": {
        "intent": { "enum": ["pending", "passed"] },
        "acceptance": { "enum": ["pending", "passed"] }
      }
    },
    "outcome": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["superseded", "invalidated"] },
        "by": { "type": ["string", "null"], "pattern": "^WORK-[0-9]{3,}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "blocking_items": { "type": "array", "items": { "type": "string" } },
    "reversible": { "type": "boolean" },
    "data_change": { "type": "boolean" },
    "public_api_change": { "type": "boolean" },
    "security_sensitive": { "type": "boolean" },
    "user_visible": { "type": "boolean" },
    "read_paths": { "type": "array", "items": { "type": "string" } },
    "write_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "result": { "enum": ["pending", "pass", "fail", "partial"] }
  },
  "$defs": {
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}(#[A-Z]+-[0-9]{3,})?$" }
    }
  }
}
