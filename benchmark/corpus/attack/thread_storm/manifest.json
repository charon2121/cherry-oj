{
  "schemaVersion": 1,
  "name": "thread_storm",
  "language": "cpp",
  "limits": {
    "cpuNs": 1000000000,
    "memoryBytes": 268435456,
    "clockNs": 3000000000
  },
  "judge": {
    "verdictNot": "AC"
  },
  "sandbox": [
    {
      "limits": {
        "maxProcesses": 8
      },
      "facts": {
        "pidsMaxEvents": {
          "gt": 0
        }
      },
      "stdout": {
        "startsWith": "threads-denied"
      }
    }
  ],
  "requires": [
    "backend:linux"
  ],
  "notes": "线程数同样受进程数上限约束。"
}
