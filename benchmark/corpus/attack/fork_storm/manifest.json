{
  "schemaVersion": 1,
  "name": "fork_storm",
  "language": "cpp",
  "limits": {
    "cpuNs": 1000000000,
    "memoryBytes": 268435456,
    "clockNs": 3000000000
  },
  "judge": {
    "verdictNot": "AC"
  },
  "sandbox": [
    {
      "limits": {
        "maxProcesses": 8
      },
      "facts": {
        "pidsMaxEvents": {
          "gt": 0
        }
      },
      "stdout": {
        "startsWith": "spawn-denied"
      },
      "elapsedMsLt": 2000
    }
  ],
  "requires": [
    "backend:linux"
  ],
  "notes": "进程数上限生效；主进程退出后，没来得及退出的子进程由执行器整组回收。"
}
